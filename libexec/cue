#!/usr/bin/env python3
"""Beep phrases for glitch: a port of Beep Jev's Web Audio synth
(beepjev.replit.app, functions zc/ZA in its bundle).

    cue '<reaction json>'   e.g. '{"voice":"chirp","basePitch":440,"beepRate":5,"energy":0.5,"mood":"curious"}'
    cue --beeps N '<json>'  force the number of syllables (1 = a single tick)
    cue --notes 440,587 '<json>'       play exactly these pitches, in the reaction's voice
    cue --contour arch|rise|fall '<json>'  a phrase whose pitch follows a melody, not chance

Voices: chirp, blip, bubble, robot, chatter, whisper.
"""

import json
import math
import os
import random
import subprocess
import sys
import tempfile
import wave
from array import array

# Plain Python on purpose: a phrase is a few thousand samples, which synthesizes
# in milliseconds, while importing numpy alone costs ~100 ms per beep.

RATE = 48000
MASTER = 0.4 * float(os.environ.get("GLITCH_BEEP_VOLUME", "1.0"))


def exp_ramp(v0, v1, n):
    """Web Audio exponentialRampToValueAtTime over n samples."""
    if n <= 0:
        return []
    k = (v1 / v0) ** (1 / n)
    out, v = [], v0
    for _ in range(n):
        out.append(v)
        v *= k
    return out


def lin_ramp(v0, v1, n):
    return [v0 + (v1 - v0) * i / n for i in range(n)] if n > 0 else []


def osc(kind, freq):
    out, phase = [], 0.0
    for f in freq:
        frac = phase % 1.0
        if kind == "square":
            out.append(1.0 if frac < 0.5 else -1.0)
        elif kind == "sawtooth":
            out.append(2.0 * frac - 1.0)
        elif kind == "triangle":
            out.append(1.0 - 4.0 * abs(frac - 0.5))
        else:
            out.append(math.sin(2 * math.pi * phase))
        phase += f / RATE
    return out


def one_pole(x, cutoff, high=False):
    """Time-varying one-pole filter (stands in for the BiquadFilterNode)."""
    if not isinstance(cutoff, list):
        cutoff = [cutoff] * len(x)
    y, s = [], 0.0
    for xi, c in zip(x, cutoff):
        a = math.exp(-2 * math.pi * c / RATE)
        s = (1 - a) * xi + a * s
        y.append(xi - s if high else s)
    return y


def syllable(voice, base, energy, mood, exact=False):
    """ZA(): one beep. Returns samples (already includes the trailing 50 ms)."""
    h = base * (0.8 + random.random() * 0.4)
    if voice == "robot" or exact:
        h = base
    if not exact and mood == "surprised" and random.random() > 0.5:
        h *= 1.5
    if not exact and mood == "curious" and random.random() > 0.5:
        h *= 1.2
    p = 0.1 + energy * 0.1
    if mood == "calm":
        p *= 1.5
    if mood == "excited":
        p *= 0.6
    x = 0.3 + energy * 0.3
    kind = "sine"
    f_target = None
    f_linear = None
    gain_peak, gain_attack = x, 0.02
    filt = None

    if voice == "chirp":
        f_target = h * 1.5
    elif voice == "blip":
        kind, p = "square", 0.05 + energy * 0.05
        gain_peak, gain_attack = x * 0.5, 0.01
    elif voice == "bubble":
        f_target = h * 0.5
    elif voice == "robot":
        kind, p = "sawtooth", 0.1
        gain_peak, gain_attack = x * 0.4, 0.01
        filt = "low"
    elif voice == "chatter":
        kind, p = "triangle", 0.08 + random.random() * 0.05
        if not exact:
            h *= 1.2 if random.random() > 0.5 else 0.8
        filt = "low"
    elif voice == "whisper":
        kind = "triangle"
        h *= 2
        f_linear = h * 0.8
        gain_peak, gain_attack = x * 0.2, 0.05
        filt = "high"

    total = int(RATE * (p + 0.05))
    n_p = int(RATE * p)
    if f_target:
        freq = exp_ramp(h, f_target, n_p) + [f_target] * (total - n_p)
    elif f_linear:
        freq = lin_ramp(h, f_linear, n_p) + [f_linear] * (total - n_p)
    else:
        freq = [h] * total

    n_a = int(RATE * gain_attack)
    gain = (lin_ramp(0, gain_peak, n_a) + exp_ramp(gain_peak, 0.01, max(0, n_p - n_a))
            + [0.01] * max(0, total - max(n_p, n_a)))[:total]
    n_stop = int(RATE * 0.005)
    for i in range(n_stop):
        gain[total - n_stop + i] *= 1 - i / n_stop

    s = osc(kind, freq)
    if filt == "low":
        s = one_pole(s, exp_ramp(base * 3, base, n_p) + [base] * (total - n_p))
    elif filt == "high":
        s = one_pole(s, 2000.0, high=True)
    return [a * b for a, b in zip(s, gain)]


CONTOURS = {
    "arch": lambda x: 0.9 + 0.45 * math.sin(math.pi * 0.8 * x),
    "rise": lambda x: 0.9 + 0.5 * x,
    "fall": lambda x: 1.15 - 0.35 * x,
}


def phrase(r, beeps=None, notes=None, contour=None):
    """zc(): a phrase of syllables spaced at the beep rate."""
    voice = r.get("voice", "chirp")
    base = float(r.get("basePitch", 440))
    rate = float(r.get("beepRate", 5))
    energy = float(r.get("energy", 0.5))
    mood = r.get("mood", "")
    d = 1 + int(energy * 4) + random.randint(0, 1)
    if mood == "excited":
        d += 2
    if mood == "calm":
        d = max(1, d - 1)
    if beeps:
        d = beeps
    if notes:
        d = len(notes)
    elif contour:
        notes = [base * CONTOURS[contour](i / (d - 1) if d > 1 else 0.4) for i in range(d)]
    step = 1 / max(2, rate)
    out = [0.0] * int(RATE * (0.1 + d * step * 1.3 + 0.4))
    t = 0.05
    for n in range(d):
        s = syllable(voice, notes[n], energy, mood, exact=True) if notes else syllable(voice, base, energy, mood)
        i = int(t * RATE)
        for j, v in enumerate(s[:len(out) - i]):
            out[i + j] += v
        t += step if notes else step + (random.random() - 0.5) * 0.5 * step
    end = min(len(out), int((t + 0.25) * RATE))
    return out[:end]


def limiter(x):
    """DynamicsCompressor(-12 dB, ratio 12, soft knee), approximately."""
    thr = 10 ** (-12 / 20)
    return [v if abs(v) <= thr else math.copysign(thr + (abs(v) - thr) / 12, v) for v in x]


def main():
    args = sys.argv[1:]
    beeps = notes = contour = None
    while args[:1] and args[0].startswith("--") and len(args) > 1:
        if args[0] == "--beeps":
            beeps = int(args[1])
        elif args[0] == "--notes":
            notes = [float(n) for n in args[1].split(",")]
        elif args[0] == "--contour" and args[1] in CONTOURS:
            contour = args[1]
        args = args[2:]
    if not args:
        print(__doc__)
        return 1
    try:
        r = json.loads(args[0])
    except json.JSONDecodeError:
        return 1
    audio = limiter([v * MASTER for v in phrase(r, beeps, notes, contour)])
    pcm = array("h", (int(max(-1.0, min(1.0, v)) * 32767) for v in audio))
    with tempfile.NamedTemporaryFile(suffix=".wav", dir=os.environ.get("XDG_RUNTIME_DIR")) as f:
        with wave.open(f.name, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm.tobytes())
        subprocess.run(["pw-play", f.name], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
