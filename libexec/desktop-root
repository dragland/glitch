#!/bin/bash
# Root half of install.sh's desktop control step: ydotool, and /dev/uinput for
# the user at the seat. uaccess gives the active session an ACL, so nobody joins
# the input group (the package's own 80-uinput.rules grants only that group,
# which could also read every keyboard) or logs in again. The rule must sort
# before 73-seat-late.rules.
set -euo pipefail
pacman -S --needed --noconfirm ydotool
echo uinput >/etc/modules-load.d/uinput.conf
echo 'KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"' >/etc/udev/rules.d/70-uinput.rules
udevadm control --reload-rules
modprobe uinput
udevadm trigger --action=change --subsystem-match=misc --sysname-match=uinput
udevadm settle
