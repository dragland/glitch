#!/usr/bin/env python3
"""Turn one of the agent's working thoughts into a short Mandarin line for the mutter.

    echo "I'm checking how the timer is set up. Then ..." | mandarin

Takes the thought's first sentence, has glitch-mind (the local Qwen3) say it in simple
Mandarin, and prints {"en", "zh", "pinyin", "ruby"}: ruby is the line cut into
[text, pinyin] pairs, one per character, with "" for what has no reading. Prints nothing if the model is away, slow
or answers with something that isn't a short Chinese sentence; errors go to stderr.
"""

import json
import os
import re
import sys
import urllib.request

URL = "http://127.0.0.1:8765/v1/chat/completions"
KEY = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "glitch", "mind.key")
SYSTEM = ("You translate an AI assistant's working thoughts into Mandarin for a beginner learner. "
          "Reply with one short, natural spoken sentence in Simplified Chinese, 20 characters at most, "
          "using common everyday words. Leave out file names, paths, code and numbers; say the idea "
          "simply instead. Output only the Chinese sentence.")
MIN_EN, MAX_EN, MAX_ZH = 12, 240, 40
HAN = re.compile(r"[一-鿿]")


def first_sentence(text):
    text = " ".join(text.split())
    m = re.search(r"[.!?](\s|$)", text)
    return (text[:m.end()] if m else text).strip()[:MAX_EN]


def translate(en):
    # Qwen3 thinks before answering unless the turn ends in /no_think.
    body = {"messages": [{"role": "system", "content": SYSTEM}, {"role": "user", "content": en + " /no_think"}],
            "temperature": 0.2, "max_tokens": 60}
    with open(KEY) as f:
        key = f.read().strip()
    req = urllib.request.Request(URL, json.dumps(body).encode(),
                                 {"Content-Type": "application/json", "Authorization": f"Bearer {key}"})
    with urllib.request.urlopen(req, timeout=6) as r:
        out = json.load(r)["choices"][0]["message"]["content"]
    out = re.sub(r"<think>.*?</think>", "", out, flags=re.DOTALL).strip().splitlines()
    return out[0].strip(" \"'“”「」") if out else ""


def ruby(zh):
    """pypinyin reads the whole line (so 行 in 银行 is háng) and gives one item per
    character, or a run of other text back as it was."""
    try:
        from pypinyin import Style, lazy_pinyin
    except ImportError:
        return []
    out, i = [], 0
    for item in lazy_pinyin(zh, style=Style.TONE):
        if i < len(zh) and HAN.match(zh[i]):
            out.append([zh[i], item])
            i += 1
        elif zh.startswith(item, i) and item:
            out.append([item, ""])
            i += len(item)
        else:
            return []
    return out if i == len(zh) else []


def main():
    en = first_sentence(sys.stdin.read())
    if len(en) < MIN_EN:
        return 0
    zh = translate(en)
    if not zh or len(zh) > MAX_ZH or len(HAN.findall(zh)) < 2:
        print(f"mandarin: unusable answer {zh!r}", file=sys.stderr)
        return 0
    pairs = ruby(zh)
    spoken = re.sub(r"\s+(?=[，。！？、；：])", "", " ".join(p or t.strip() for t, p in pairs if p or t.strip()))
    print(json.dumps({"en": en, "zh": zh, "pinyin": spoken, "ruby": pairs}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, IndexError) as e:
        print(f"mandarin: {e}", file=sys.stderr)
        sys.exit(0)
