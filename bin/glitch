#!/bin/bash

# glitch: tap a key, speak, tap again, and your coding agent does it, while an
# expressive orb (grown from Yohei Nakajima's Beep Jev) shows how it's going,
# beeps its mood, and speaks a short answer.
#
#   glitch toggle [--new]  start recording, or stop and send (Super+D / Super+Alt+D)
#   glitch open            open the current session in a terminal (Super+Alt+Shift+D)
#   glitch cancel          stop recording, the running turn and speech (Super+Alt+Backspace)
#   glitch new             start a fresh session (after the running turn)
#   glitch hush            stop speaking
#   glitch say <text>      speak text with glitch's voice
#   glitch state           print the current orb state
#   glitch pair            speak a code that pairs a phone with the portal (2 minutes)
#   glitch unpair          forget every paired phone
#   glitch portal          run the phone portal's server
#   glitch cert [--renew]  make the portal's certificate, and the CA file the phone installs
#   glitch phone [--status|--off]  set up the phone portal (address, certificate, QR code), report on it, or turn it off
#
# Defaults in <repo>/config, overrides in ~/.config/glitch, downloads in
# ~/.local/share/glitch, live state in $XDG_RUNTIME_DIR/glitch, the reply card's
# record in ~/.local/state/glitch.

set -uo pipefail
export LC_CTYPE=${LC_CTYPE:-C.UTF-8} # string slicing below must count characters

GLITCH_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/glitch"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/glitch"
RT="${XDG_RUNTIME_DIR:-/run/user/$UID}/glitch"
mkdir -p "$RT"
CARD="$RT/card"
[[ $RT == "/run/user/$UID/glitch" ]] && CARD="${XDG_STATE_HOME:-$HOME/.local/state}/glitch/card"

# shellcheck source=../config/glitch.conf
. "$GLITCH_HOME/config/glitch.conf"
# shellcheck source=/dev/null
[[ -f $USER_CONF/glitch.conf ]] && . "$USER_CONF/glitch.conf"
export GLITCH_BEEP_VOLUME="${BEEP_VOLUME:-2.0}" MIND JEV_MODEL OPENAI_DECIDE_MODEL GLITCH_MIND_PORT="$MIND_PORT"

# glitch-mind starts ahead of the shell, which card_sweep below needs.
case "${1:-}" in
_mind)
  # Two slots so the final reaction never queues behind a live one; prompts are ~400
  # tokens, so 1024 per slot is plenty. The key (made by install.sh) keeps web pages
  # from driving the model through localhost. A CPU build ignores -ngl.
  exec "$DATA/llama/llama-server" -m "$DATA/models/Qwen3-1.7B-Q4_K_M.gguf" -ngl 99 --host 127.0.0.1 --port "$MIND_PORT" \
    -c 2048 -np 2 --no-slots --no-webui --api-key-file "$DATA/mind.key"
  ;;
_remote)
  # 78 is EX_CONFIG, which glitch-remote.service doesn't restart on.
  [[ $REMOTE == 1 ]] || { echo "glitch remote: off (REMOTE=1 in $USER_CONF/glitch.conf turns it on)" >&2; exit 78; }
  cd "$WORKDIR" || exit 78
  # An unknown mode stops claude at startup, and the unit would restart it every 30 s.
  [[ $REMOTE_PERMISSION_MODE =~ ^(default|acceptEdits|auto|plan|dontAsk|bypassPermissions)$ ]] ||
    { echo "glitch remote: REMOTE_PERMISSION_MODE=$REMOTE_PERMISSION_MODE isn't a permission mode" >&2; exit 78; }
  # claude is mise's wrapper (omarchy-agent-account-exec), which sets the Claude home
  # (CLAUDE_CONFIG_DIR, which glitch _reap reads) and execs the real binary. Never add
  # --no-create-session-in-dir: it archives every session on stop.
  exec claude remote-control --spawn same-dir --chrome --permission-mode "$REMOTE_PERMISSION_MODE"
  ;;
esac

PY="$DATA/venv/bin/python"
PORTAL=desk
[[ ${GLITCH_PORTAL:-} == phone ]] && PORTAL=phone
export GLITCH_PORTAL=$PORTAL
PH="$RT/phone"
[[ $PORTAL == phone ]] && mkdir -p "$PH/clips"
CUE="$GLITCH_HOME/libexec/cue"
DECIDE="$GLITCH_HOME/libexec/decide"
SPEAK_HELPER="$GLITCH_HOME/libexec/speak"

# Every detached child closes fds 8 (key.lock) and 9 (turn.lock), and the mutter's
# children close 6 (mutter.lock): an inherited fd keeps the flock held after its owner exits.

if [[ -f $RT/glitch.log ]] && (($(wc -l <"$RT/glitch.log") > 2000)); then
  tail -n 1000 "$RT/glitch.log" >"$RT/glitch.log.tmp" && mv "$RT/glitch.log.tmp" "$RT/glitch.log"
fi

log() { printf '%(%T)T.%s %s\n' -1 "${EPOCHREALTIME:11:3}" "$*" >>"$RT/glitch.log"; }

write_atomic() { printf '%s\n' "$2" >"$1.$$" && mv "$1.$$" "$1"; }

# jqs FILTER [OPTION...] -- STRING...: jq -c with $s the array of STRINGs. They go in on
# stdin because an agent's text can pass Linux's 128 KiB limit on one argument. No bash
# string holds a NUL, so NUL separates them.
jqs() {
  local f=$1 o=()
  shift
  while (($#)) && [[ $1 != -- ]]; do o+=("$1"); shift; done
  shift
  printf '%s\0' "$@" | jq -cRs "${o[@]}" "(split(\"\\u0000\") | .[:-1]) as \$s | $f"
}

# CLOCK: centiseconds since boot, which an NTP step doesn't move. libexec/portal reads
# the same clock as CLOCK_BOOTTIME.
clock() { local s; read -r s _ </proc/uptime; CLOCK=$((10#${s/./})); }

# In vis, \p{DI} is Oniguruma's Default_Ignorable_Code_Point (variation selectors,
# Hangul fillers) and U+2800 is the blank braille cell.
# shellcheck disable=SC2016 # jq, not bash
JQ_DEFS='
def hex: if . < 16 then "0123456789ABCDEF"[.:.+1] else (. / 16 | floor | hex) + (. % 16 | hex) end;
def vis: gsub("(?<c>(?![\n\t ])[\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}\\p{Zs}\\p{Co}\\p{Cn}\\p{DI}\\x{2800}])"; "\\u{\(.c | explode[0] | hex)}");
def clip(n): if length > n then .[0:n] + "…" else . end;
def base: tostring | sub("/+$"; "") | split("/") | last // "";
def named(d): if . == "" then d else . end;
def host: tostring | sub("^[a-zA-Z][a-zA-Z0-9+.-]*://"; "") | sub("[/?#].*$"; "") | sub("^[^@]*@"; "") | sub(":[0-9]+$"; "") | sub("^www\\."; "");
def opts($with): if length == 0 then . elif .[0] == "--" then .[1:]
  elif .[0] | test("^(" + $with + ")$") then .[2:] | opts($with)
  elif .[0] | test("^-") then .[1:] | opts($with) else . end;
def wopts($with): opts($with) | if length > 0 and (.[0] | test("^[0-9.]+[smhd]?$")) then .[1:] | wopts($with) else . end;
def word: sub("^[\"\u0027]+"; "") | sub("[\"\u0027;&|()<>`].*$"; "");
def lead: sub("^\\s+"; "") | sub("^[(\"\u0027]+"; "") | sub("^cd(\\s[^;&|]*)?(&&|;)"; "");
def shell:
  def prog: if length == 0 then "a command"
  elif .[0] | test("^[A-Za-z_][A-Za-z0-9_]*\\+?=") then if .[0] | test("\\$\\(|`") then "a script" else .[1:] | prog end
  elif .[0] | test("^[0-9&]*[<>]+$") then .[2:] | prog
  elif .[0] | test("^[0-9&]*[<>]") then .[1:] | prog
  elif .[0] | test("^(for|if|while|until|case|select|function|do|then|else|elif|export|local|declare|readonly|set|\\[\\[|\\[|\\{|!|\\(\\(.*)$") then "a script"
  else (.[0] | word | base) as $p |
    if $p == "command" and (.[1] // "" | test("^-[vV]$")) then "command"
    elif $p | test("^(sudo|doas|pkexec|env|timeout|nice|ionice|nohup|time|command|exec|xargs|setsid|stdbuf)$") then
      .[1:] | wopts({sudo: "-[ugCDhprtU]", doas: "-[uC]", env: "-[uCS]", timeout: "-[sk]", nice: "-n", ionice: "-[cnp]",
        xargs: "-[InPdLaEs]", stdbuf: "-[ioe]"}[$p] // "") | prog
    elif ($p | test("^(ba|z|da)?sh$")) and (.[1:3] | any(test("^-[a-z]*c[a-z]*$"))) then
      (if .[1] | test("c") then .[2:] else .[3:] end) | join(" ") | shell
    elif $p == "" or ($p | test("[$`{}*?\\\\]")) then "a command"
    elif $p | test("^(git|npm|pnpm|yarn|bun|cargo|go|make|systemctl|docker|podman|pacman|yay|uv|pip|pip3|gh|kubectl)$") then
      (.[1:] | opts("-[CcfHRn]|--(git-dir|work-tree|namespace|context|repo|directory|file|host)") | .[0] // "" | word) as $s
      | $p + (if $s | test("^[a-z][a-z0-9-]*$") then " " + $s else "" end)
    else $p end
  end;
  (split("\n") | map(select(test("^\\s*(#|$)") | not)) | first // "") | until(lead == .; lead)
  | [splits("\\s+")] | map(select(. != "")) | prog;
def mcp: if test("^claude-in-chrome$") then "using the browser"
  else sub("^(plugin_|claude_ai_)"; "") | gsub("[_-]+"; " ") | ascii_downcase | sub("^(?<w>\\S+) \\k<w>$"; "\(.w)") | if . == "" then "working" else "using " + . end end;
def status(n; i): (i // {}) as $i |
  if n | test("^(Bash|Shell)$") then "running " + ($i.command // "" | tostring | shell)
  elif n | test("^(Read|NotebookRead)$") then "reading " + ($i.file_path // $i.notebook_path // "" | base | named("a file"))
  elif n == "LS" then "listing " + ($i.path // "" | base | named("files"))
  elif n | test("^(Edit|MultiEdit|NotebookEdit)$") then "editing " + ($i.file_path // $i.notebook_path // "" | base | named("a file"))
  elif n == "Write" then "writing " + ($i.file_path // "" | base | named("a file"))
  elif n == "Delete" then "deleting " + ($i.file_path // "" | base | named("a file"))
  elif n == "Grep" then "searching files"
  elif n == "Glob" then "finding files"
  elif n == "WebFetch" then "reading " + ($i.url // "" | host | named("a web page"))
  elif n == "WebSearch" then "searching the web"
  elif n == "ToolSearch" then "looking up tools"
  elif n | test("^(Task|Agent)$") then "delegating"
  elif n | test("^(TodoWrite|TaskCreate|TaskUpdate)$") then "updating the to-do list"
  elif n == "Skill" then "loading a skill"
  elif n | test("^(BashOutput|TaskOutput)$") then "checking a background command"
  elif n | test("^(KillShell|KillBash|TaskStop)$") then "stopping a background command"
  elif n == "Monitor" then "watching a background command"
  elif n | test("^mcp__.+__") then n | capture("^mcp__(?<s>.+?)__").s | mcp
  else "working" end
  | gsub("[\t\n]"; " ") | vis | clip(60);
'

state_file() { if [[ $PORTAL == phone ]]; then echo "$PH/state.json"; else echo "$RT/state.json"; fi; }

set_state() {
  local json
  json=$(jq -cn --arg s "$1" --argjson reaction "${REACTION:-null}" --arg status "${3:-}" --arg portal "$PORTAL" \
    '{state:$s, reaction:$reaction} + if $portal == "phone" then {status:$status} else {} end')
  write_atomic "$(state_file)" "$json"
  log "state $1 ${2:-}"
  orb_set "$json" "${2:-}"
}

orb_set() {
  if [[ $PORTAL == phone ]]; then
    # shellcheck disable=SC2016 # jq, not bash
    phone_send "$(jqs '{type:"state"} + ($s[0] | fromjson) + {detail:$s[1]}' -- "$1" "${2:-}")"
  else
    omarchy-shell -q glitch set "$1" >/dev/null 2>&1 || true
  fi
}

# printf writes a long line in several write() calls, so writers take the lock to
# keep lines whole.
phone_send() {
  [[ -n $1 ]] || { log "phone: ${FUNCNAME[1]} made no event"; return 1; }
  { flock 3 && printf '%s\n' "$1" >&3; } 3>>"$PH/events.jsonl"
}

page_online() {
  local pid
  { read -r pid <"$PH/online"; } 2>/dev/null && kill -0 "$pid" 2>/dev/null
}

clip_sent() {
  CLIP=$2
  # The sample rate is at byte 24 of the 44-byte WAV header; cue and Piper write 16-bit mono.
  CLIP_MS=$((($(stat -c %s "$PH/clips/$2") - 44) * 500 / $(od -An -j24 -N4 -tu4 "$PH/clips/$2")))
  phone_send "$(jq -cn --arg id "$2" --arg kind "$1" --argjson ms "$CLIP_MS" --arg env "${3:-}" --arg with "${4:-}" \
    --arg lead "${5:-0}" --arg approve "${APPROVE_ID:-}" 'def opt: if . == "" then null else . end;
    {type:"clip", id:$id, kind:$kind, ms:$ms, env:($env | opt), with:($with | opt),
     delay:(if $with == "" then 0 else $lead | tonumber * 1000 | round end), approve:($approve | opt)}')"
}

# A live signal for the orb (listed at the top of plugin/orb.mjs). A file the
# orb tails, because IPC costs a process per call.
ev() {
  if [[ $PORTAL == phone ]]; then
    local l=${*//\\/\\\\}
    phone_send "{\"type\":\"signal\",\"line\":\"${l//\"/\\\"}\"}"
  else
    printf '%s\n' "$*" >>"$RT/orb.events"
  fi
}

turn_portal() {
  local portal pid
  { read -r portal pid <"$RT/turn.portal"; } 2>/dev/null && kill -0 "$pid" 2>/dev/null && echo "$portal"
}

recording() { [[ $PORTAL == desk && -e $RT/recording ]]; }

current_sid() {
  local f="$RT/sid"
  [[ -s $f && $(cat "$RT/sid.agent" 2>/dev/null) == "$1" ]] || return 1
  ((EPOCHSECONDS - $(stat -c %Y "$f") < RESUME_WINDOW)) || return 1
  cat "$f"
}

forget_session() {
  rm -f "$RT/sid" "$RT/sid.agent" "$RT/history.jsonl"
  close_card
  phone_fresh
}

phone_fresh() {
  [[ -d $PH ]] && phone_send "{\"type\":\"fresh\"${1:+,\"idle\":true}}"
}

cmd_expire() {
  [[ ${1:-card} == card ]] && close_card
  [[ ${1:-session} == session && -z $(turn_portal) ]] && phone_fresh idle
  return 0
}

reactions() {
  local files=("$GLITCH_HOME/config/reactions.json")
  [[ -f $USER_CONF/reactions.json ]] && files+=("$USER_CONF/reactions.json")
  jq -cs "${@:2}" "(reduce .[] as \$f ({}; . * \$f)) | $1" "${files[@]}" 2>/dev/null
}

# shellcheck disable=SC2016 # jq, not bash
reaction() { reactions 'getpath($k | split(".")) // .mood.calm' --arg k "$1" || echo null; }

voice_prompt() {
  if [[ -f $USER_CONF/voice-prompt.md ]]; then cat "$USER_CONF/voice-prompt.md"; else cat "$GLITCH_HOME/config/voice-prompt.md"; fi
  if [[ $PORTAL == phone ]]; then printf '\n%s\n' "$PHONE_PROMPT"; fi
}

cue() {
  [[ $BEEPS == 1 && -x $PY && ${REACTION:-null} != null ]] || return 0
  if [[ $PORTAL == phone ]]; then
    local id="${EPOCHREALTIME/./}-cue.wav"
    "$PY" -I "$CUE" --out "$PH/clips/$id" "$@" "$REACTION" </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- && clip_sent cue "$id"
    return 0
  fi
  setsid "$PY" -I "$CUE" "$@" "$REACTION" </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
}

CHIMES=(start stop unsure)
chime() {
  local r=listening args
  case $1 in
  start) args=(--notes "440,587") ;;
  stop) args=(--notes "587,440") ;;
  unsure) r=mood.unsure args=(--beeps 1) ;;
  esac
  REACTION=$(reaction "$r") cue "${args[@]}" "${@:2}"
}

# --- speech -------------------------------------------------------------------

speech_warm() {
  SPEAK_SLOT="$RT/${1:-say}"
  rm -f "$SPEAK_SLOT.wav" "$SPEAK_SLOT.env" "$SPEAK_SLOT.ruby" "$SPEAK_SLOT.fifo"
  [[ $SPEAK == 1 && -x $PY && -f $VOICE ]] || return 0
  mkfifo "$SPEAK_SLOT.fifo" || return 0
  "$PY" -I "$SPEAK_HELPER" "$VOICE" "$SPEAK_SLOT.fifo" "$SPEAK_SLOT.wav" </dev/null >/dev/null 2>>"$RT/glitch.log" 6>&- 8>&- 9>&- &
  SPEAK_PID=$!
}

speech_render() {
  [[ -n ${SPEAK_PID:-} ]] || return 0
  timeout 5 bash -c 'printf "%s" "$1" >"$2"' _ "$1" "$SPEAK_SLOT.fifo" 2>/dev/null
  timeout 5 tail -s 0.05 --pid="$SPEAK_PID" -f /dev/null 2>/dev/null # -s: the default poll is 1 s
  kill "$SPEAK_PID" 2>/dev/null
  rm -f "$SPEAK_SLOT.fifo"
  SPEAK_PID=""
}

play() {
  local rc
  [[ -s $1 ]] || return 0
  if [[ $PORTAL == phone ]]; then
    local name=${1##*/} id end
    id="${EPOCHREALTIME/./}-${name%%.*}.wav"
    cp "$1" "$PH/clips/$id" && clip_sent "${name%%.*}" "$id" "$(cat "${1%.wav}.env" 2>/dev/null)" "${2:-}" "${3:-}" || return 0
    clock
    end=$((CLOCK + (CLIP_MS + 2000) / 10))
    while page_online && [[ ! -e $PH/clips/$id.played ]] && clock && ((CLOCK < end)); do sleep 0.1; done
    [[ $(cat "$PH/clips/$id.played" 2>/dev/null) != hushed ]]
    return
  fi
  pw-play "$1" 2>/dev/null 8>&- 9>&- &
  echo $! >"$RT/speak.pid"
  wait $! 2>/dev/null
  rc=$?
  rm -f "$RT/speak.pid"
  return $rc
}

hush() {
  local pid
  if [[ $PORTAL == phone ]]; then
    phone_send '{"type":"hush"}'
    return 0
  fi
  pid=$(cat "$RT/speak.pid" 2>/dev/null) || return 1
  kill "$pid" 2>/dev/null
  rm -f "$RT/speak.pid"
  ev hush
}

# --- the reply card -------------------------------------------------------------

markup_escape() {
  local s=${1//&/&amp;}
  s=${s//</&lt;}
  printf '%s' "${s//>/&gt;}"
}

notify() {
  local id
  # The summary and body are the agent's text, and omarchy-notification-send reads a leading dash as an option.
  [[ $1 == -* ]] && set -- "glitch: $1" "${@:2}"
  [[ ${2:-} == -* ]] && set -- "$1" " $2" "${@:3}"
  id=$(omarchy-notification-send --app-name glitch -g "󰍬" -u critical -p \
    -r "$(cat "$RT/notify.id" 2>/dev/null || echo 0)" "$@" 2>>"$RT/glitch.log") || {
    log "notify failed: $1"
    return 0
  }
  [[ $id =~ ^[0-9]+$ ]] && printf '%s' "$id" >"$RT/notify.id"
  mkdir -p "${CARD%/*}" && printf '%s' "${1//$'\n'/ }" >"$CARD"
}

close_card() {
  local summary answer
  summary=$(cat "$CARD" 2>/dev/null) || return 0
  if [[ -n $summary ]]; then
    answer=$(omarchy-shell notifications dismiss "$summary" 2>/dev/null)
    # A shell that has just started says "none" until it has restored its cards.
    [[ $answer == ok || ($answer == none && $(ps -o etimes= -C quickshell | sort -n | tail -n 1) -ge 30) ]] || return 1
  fi
  rm -f "$RT/notify.id" "$CARD"
}

card_sweep() {
  [[ -e $CARD && -z $(turn_portal) ]] || return 0
  [[ -e $RT/notify.id ]] && ((EPOCHSECONDS - $(stat -c %Y "$RT/sid" 2>/dev/null || echo 0) < CARD_SECONDS + 60)) && return 0
  close_card && log "card swept"
}

expire_later() {
  local mt
  mt=$(stat -c %Y "$RT/sid" 2>/dev/null) || return 0
  local what secs
  for what in card session; do
    secs=$CARD_SECONDS
    [[ $what == session ]] && secs=$RESUME_WINDOW
    setsid bash -c 'sleep "$1"; [[ $(stat -c %Y "$2" 2>/dev/null) == "$3" ]] && exec "$4" _expire "$5"' _ $((secs + 2)) "$RT/sid" "$mt" "$0" "$what" \
      </dev/null >/dev/null 2>&1 8>&- 9>&- &
  done
}

# --- live reactions (the local decision model, see libexec/decide) --------------

recent_history() {
  if ((HISTORY_TURNS > 0)) && [[ -s $RT/history.jsonl ]]; then
    jq -cs --arg sid "${1:-}" --argjson n "$HISTORY_TURNS" '[.[] | select(.sid == $sid)] | .[-$n:]' "$RT/history.jsonl"
  else
    echo '[]'
  fi
}

live_decide() {
  [[ -x $PY ]] || return 0
  # shellcheck disable=SC2016 # jq, not bash
  write_atomic "$RT/live.in" "$(jqs '{phase:"working", user:$s[0], activity:$s[1], words:$s[2],
    history:($s[3] | fromjson), speech:($s[4] | fromjson), deadline:3}' -- "$1" "$2" "$3" \
    "$(recent_history "$SID")" "$(cat "$RT/speech.json" 2>/dev/null || echo null)")"
  setsid "$0" _live </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
}

cmd_live() {
  local r state
  exec 7>"$RT/live.lock"
  flock -n 7 || return 0
  while mv "$RT/live.in" "$RT/live.cur" 2>/dev/null; do
    "$PY" -I "$DECIDE" <"$RT/live.cur" >"$RT/live.out" &
    echo $! >"$RT/live.pid"
    wait $!
    rm -f "$RT/live.pid"
    r=$(cat "$RT/live.out" 2>/dev/null)
    [[ -n $r && -e $RT/turn.pid ]] || continue
    state=$(cat "$(state_file)" 2>/dev/null)
    [[ $(jq -r .state <<<"$state" 2>/dev/null) =~ ^(thinking|tool)$ ]] || continue
    write_atomic "$RT/live.json" "$r"
    log "live $r"
    orb_set "$(jq -c --argjson r "$r" '.reaction = $r' <<<"$state")"
  done
  exec 7>&-
  [[ -e $RT/live.in ]] && exec "$0" _live
}

stop_live() {
  local pid
  rm -f "$RT/live.in"
  pid=$(cat "$RT/live.pid" 2>/dev/null) || return 0
  grep -qs libexec/decide "/proc/$pid/cmdline" && kill "$pid" 2>/dev/null
}

# --- the trace and the mutter ----------------------------------------------------------

# These patterns backtrack quadratically over a long run of spaces, so the cut comes first.
# shellcheck disable=SC2016 # jq, not bash
TRACE_JQ='def shown: tostring | .[0:4000] | [splits("\n") | select(test("^\\s*(SAY|MOOD):") | not)] | join("\n")
  | gsub("\\*\\*|`"; "") | gsub("\\s*\n\\s*"; "\n") | sub("^\\s+"; "") | sub("\\s+$"; "") | clip(400);'

trace() {
  [[ $PORTAL == phone ]] || return 0
  phone_send "$(jq -c --arg k "$1" "$JQ_DEFS$TRACE_JQ"'{type:"trace", kind:$k, text:shown} | select(.text != "")' <<<"$2" 2>/dev/null)"
}

working() {
  [[ -e $RT/turn.pid ]] && ! recording && [[ $(jq -r .state "$(state_file)" 2>/dev/null) =~ ^(thinking|tool)$ ]]
}

mutter() {
  [[ $MUTTER == 1 && $SPEAK == 1 && -x $PY && -n $MUTTER_VOICE && -f $MUTTER_VOICE ]] || return 1
  ((EPOCHSECONDS - LAST_MUTTER >= MUTTER_EVERY)) && working || return 1
  [[ $PORTAL == desk ]] || page_online || return 1
  LAST_MUTTER=$EPOCHSECONDS
  "$0" _mutter <<<"$1" >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
}

# The thought comes on stdin: Linux caps one argument at 128 KiB.
cmd_mutter() {
  THOUGHT=$(cat)
  exec 6>"$RT/mutter.lock"
  if flock -n 6; then
    echo $$ >"$RT/mutter.pid"
    # bash runs a trap only once the child it is waiting on has gone.
    trap 'trace think "$THOUGHT"; exit 0' TERM
    mutter_once && return 0
    trap - TERM
  fi
  trace think "$THOUGHT"
}

mutter_once() {
  local zh id event rest ruby
  jq -r . <<<"$THOUGHT" | "$PY" -I "$GLITCH_HOME/libexec/mandarin" >"$RT/mutter.json" 2>>"$RT/glitch.log" 6>&-
  zh=$(jq -r '.zh // ""' "$RT/mutter.json" 2>/dev/null)
  [[ -n $zh ]] || return 1
  log "mutter $zh"
  VOICE=$MUTTER_VOICE speech_warm mutter
  speech_render "$zh"
  [[ -s $RT/mutter.wav ]] && working || return 1
  if [[ $PORTAL == phone ]]; then
    id="${EPOCHREALTIME/./}-mutter.wav"
    cp "$RT/mutter.wav" "$PH/clips/$id" || return 1
    ruby=$(cat "$RT/mutter.ruby" 2>/dev/null)
    event=$(jq -c --arg id "$id" --argjson ruby "${ruby:-[]}" '{type:"trace", kind:"zh", text:.en, zh, ruby:$ruby, clip:$id}' "$RT/mutter.json") || return 1
    rest=$(jq -c '.rest | select(. != "")' "$RT/mutter.json")
    trap - TERM
    [[ -n $rest ]] && trace think "$rest"
    phone_send "$event"
    clip_sent mutter "$id" "$(cat "$RT/mutter.env" 2>/dev/null)"
    sleep $(((CLIP_MS + 999) / 1000)) 6>&-
  else
    trap - TERM
    [[ -s $RT/mutter.env ]] && ev "say $(<"$RT/mutter.env")"
    pw-play --volume "$MUTTER_VOLUME" "$RT/mutter.wav" 2>/dev/null 6>&-
  fi
}

stop_mutter() {
  local pid kids=() playing=""
  pid=$(cat "$RT/mutter.pid" 2>/dev/null) || return 0
  rm -f "$RT/mutter.pid"
  grep -qs _mutter "/proc/$pid/cmdline" || return 0
  pgrep -P "$pid" -x pw-play >/dev/null && playing=1
  mapfile -t kids < <(pgrep -P "$pid")
  kill "$pid" "${kids[@]}" 2>/dev/null
  [[ -n $playing ]] && PORTAL=desk ev hush
}

# --- agent adapters ---------------------------------------------------------------
# An adapter reads the prompt on stdin, takes an optional session id, and emits
# lines: "sid <id>", "mode <permission mode>", "tool <category>\t<id>\t<label>\t<phrase>",
# "toolend <id>", "words <text>", "ctx <tokens in context>", "window <context
# window>", "say <text>", "mood <word>", "result <json string>", "error <text>",
# "think <json string>", "note <json string>", "denied <n>", then "exit <status>" last.
# `think` is a whole thought (a summary of the agent's reasoning) and `note` a whole
# message it wrote. Tool categories: look, make, run,
# delegate. The phrase is the phone's status line (jq `status`). A subagent's own
# tool calls are dropped. `toolend` comes when the call's work is done, which for a
# background subagent is later than its tool result. `ctx` and `window` are Claude's
# only: Codex reports neither, so it shows no tide.

adapter_claude() {
  local sid=${1:-} args
  # Nothing can answer a permission prompt in -p mode, so the hook sends each
  # one to `glitch _approve`.
  local hook wait=75
  [[ $PORTAL == phone ]] && wait=$((PORTAL_APPROVE_TIMEOUT + 15))
  hook=$(jq -cn --arg cmd "$(printf '%q _approve' "$GLITCH_HOME/bin/glitch")" --argjson wait "$wait" \
    '{hooks: {PermissionRequest: [{matcher: "*", hooks: [{type: "command", command: $cmd, timeout: $wait}]}]}}')
  args=(-p --output-format stream-json --verbose --include-partial-messages
    --permission-mode auto --permission-prompts none --settings "$hook" --chrome
    --thinking-display summarized
    --append-system-prompt "$(voice_prompt)")
  [[ -n $sid ]] && args+=(--resume "$sid")
  # stream-json requires --verbose. SIGINT ends a turn cleanly (SIGTERM leaves
  # it unrecorded). -p hides thinking unless --thinking-display asks for its summaries.
  # `claude --help` doesn't list that flag, so re-check it when Claude changes.
  timeout --signal=INT --kill-after=15 "$TURN_TIMEOUT" claude "${args[@]}" 2>>"$RT/glitch.log" 9>&- |
    jq --unbuffered -rR "$JQ_DEFS"'fromjson? // empty |
    def tlabel: .name + (
      (.input.file_path // .input.path // .input.command // .input.pattern // .input.url // .input.description // "")
      | tostring | (split("\n")[0] // "") | gsub("\t"; " ") | sub("^/home/[^/]+/"; "~/") | if . == "" then "" else ": " + clip(48) end);
    def id: tostring | gsub("\\s"; "_");
    def tcat: .name as $n |
      if ($n | test("^(Read|Glob|Grep|LS|WebFetch|WebSearch|ToolSearch)$")) then "look"
      elif ($n | test("^(Edit|MultiEdit|Write|NotebookEdit)$")) then "make"
      elif ($n | test("^(Task|Agent)$")) then "delegate"
      else "run" end;
    def tagline(k): [.[] | select(test("^\\s*" + k + ":"))] | last // "" | sub("^\\s*" + k + ":\\s*"; "");
    if .type == "stream_event" then
      (.event.delta // {} | (.text // .thinking // empty) | "words \(gsub("\\s+"; " "))")
    elif .type == "system" and .subtype == "init" then "sid \(.session_id)", "mode \(.permissionMode // "?")"
    elif .type == "assistant" and .parent_tool_use_id == null then
      (.message.content[]? |
        if .type == "tool_use" then "tool \(tcat)\t\(.id | id)\t\(tlabel)\t\(status(.name; .input))"
        elif .type == "thinking" then .thinking // "" | select(test("\\S")) | "think \(tojson)"
        elif .type == "text" then .text // "" | select(test("\\S")) | "note \(tojson)"
        else empty end),
      (.message.usage // empty | "ctx \((.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0))")
    elif .type == "user" and .parent_tool_use_id == null then
      # The result of a background subagent only says it was launched; the
      # task_notification below is when it finishes.
      if ((.tool_use_result | objects | .status) // "") == "async_launched" then empty
      else (.message.content | arrays | .[] | objects | select(.type == "tool_result") | "toolend \(.tool_use_id | id)") end
    elif .type == "system" and .subtype == "task_notification" and .tool_use_id != null then "toolend \(.tool_use_id | id)"
    elif .type == "result" then
      "sid \(.session_id)",
      (([.modelUsage[]?.contextWindow] | map(select(. != null)) | max) // empty | "window \(.)"),
      (if (.permission_denials // [] | length) > 0 then "denied \(.permission_denials | length)" else empty end),
      (if .is_error then "error \((.result | select(. != "")) // .subtype // "error" | tostring | gsub("\n"; " "))"
       else (.result // "" | split("\n")) as $ls |
         "mood \($ls | tagline("MOOD") | ascii_downcase | gsub("[^a-z]"; ""))",
         "say \($ls | tagline("SAY") | gsub("\n"; " "))",
         "result \([$ls[] | select(test("^\\s*(SAY|MOOD):") | not)] | join("\n") | sub("\\s+$"; "") | tojson)"
       end)
    else empty end'
  echo "exit ${PIPESTATUS[0]}"
}

# Codex CLI (`codex exec --json`, tested on codex-cli 0.162.1). The stream has
# no text deltas: each agent_message arrives whole on item.completed, and the
# last one before turn.completed is the final reply. `exec resume` has no
# --approve-for-me/-s/-C flags, so the same policy goes in as -c keys (what
# --approve-for-me sets: workspace-write, on-request, auto_review), and the
# session runs in the caller's cwd, which glitch has already cd'd to.
adapter_codex() {
  local sid=${1:-} args
  args=(--json --skip-git-repo-check
    -c 'sandbox_mode="workspace-write"' -c 'approval_policy="on-request"'
    -c 'approvals_reviewer="auto_review"'
    -c "developer_instructions=$(voice_prompt | jq -Rs .)")
  if [[ -n $sid ]]; then args=(exec resume "${args[@]}" "$sid" -); else args=(exec "${args[@]}" -); fi
  # SIGINT ends a turn cleanly (it's recorded as interrupted and stays resumable).
  timeout --signal=INT --kill-after=15 "$TURN_TIMEOUT" codex "${args[@]}" 2>>"$RT/glitch.log" 9>&- |
    jq --unbuffered -nrR --arg cwd "$PWD/" "$JQ_DEFS"'
    def short: tostring | (split("\n")[0] // "") | gsub("\t"; " ") | ltrimstr($cwd) | sub("^/home/[^/]+/"; "~/") | clip(48);
    def unwrap: sub("^(/usr)?/bin/(ba|z)?sh -l?c "; "") | sub("^\u0027(?<c>.*)\u0027$"; "\(.c)") | sub("^\"(?<c>.*)\"$"; "\(.c)");
    def tagline(k): [.[] | select(test("^\\s*" + k + ":"))] | last // "" | sub("^\\s*" + k + ":\\s*"; "");
    def plain: split("\n") | map(select(test("^\\s*(SAY|MOOD):") | not)) | join("\n") | sub("\\s+$"; "");
    def toolline: if .type == "command_execution" then (.command | unwrap) as $c |
        (if ($c | test("^\\s*(ls|cat|head|tail|rg|grep|find|fd|tree|wc|stat|file|pwd|sed -n|git (status|log|diff|show))\\b"))
         then "look" else "run" end) + "\tShell: \($c | short)"
      elif .type == "file_change" then
        "make\t\({add: "Write", delete: "Delete"}[.changes[0].kind // ""] // "Edit"): \(.changes[0].path // "" | short)" +
        (if (.changes | length) > 1 then " +\((.changes | length) - 1)" else "" end)
      elif .type == "web_search" then "look\tWebSearch: \(.query // "" | short)"
      elif .type == "mcp_tool_call" then "run\t\(.server).\(.tool)"
      elif .type == "collab_tool_call" then
        if .tool == "spawn_agent" then "delegate\tAgent: \(.prompt // "" | short)" else empty end
      else empty end;
    def status: if .type == "command_execution" then "running " + (.command // "" | tostring | shell)
      elif .type == "file_change" then
        ({add: "writing ", delete: "deleting "}[.changes[0].kind // ""] // "editing ") + (.changes[0].path // "" | base | named("a file"))
      elif .type == "web_search" then "searching the web"
      elif .type == "mcp_tool_call" then .server // "" | mcp
      elif .type == "collab_tool_call" then "delegating"
      else "working" end | gsub("[\t\n]"; " ") | vis | clip(60);
    def id: .id | tostring | gsub("\\s"; "_");
    def tool: id as $id | status as $st | toolline | sub("\t"; "\t\($id)\t") | "tool \(.)\t\($st)";
    def toolend: id as $id | toolline | "toolend \($id)";
    # Some items arrive only as item.completed (Codex batches shell calls
    # without an item.started), so a tool line is emitted on whichever comes first.
    foreach (inputs | fromjson? // empty) as $e ({seen: {}, last: "", denied: 0};
      if $e.type == "item.started" then .seen[$e.item.id] = true
      elif $e.type == "item.completed" then
        (if $e.item.type == "agent_message" then .last = $e.item.text else . end) |
        (if $e.item.status == "declined" then .denied += 1 else . end)
      else . end;
      . as $s | $e |
      if .type == "thread.started" then "sid \(.thread_id)", "mode auto_review"
      elif .type == "item.started" then .item | tool
      elif .type == "item.completed" then .item |
        if .type == "agent_message" or .type == "reasoning" then
          (if .type == "reasoning" then "think" else "note" end) as $k |
          (.text | plain | select(. != "") | "words \(gsub("\\s+"; " "))", "\($k) \(tojson)")
        elif $s.seen[.id] then toolend
        else tool, toolend end
      elif .type == "turn.failed" then "error \(.error.message // "turn failed" | gsub("\n"; " "))"
      elif .type == "turn.completed" then
        (if $s.denied > 0 then "denied \($s.denied)" else empty end),
        ($s.last | split("\n")) as $ls |
        "mood \($ls | tagline("MOOD") | ascii_downcase | gsub("[^a-z]"; ""))",
        "say \($ls | tagline("SAY") | gsub("\n"; " "))",
        "result \($s.last | plain | tojson)"
      else empty end)'
  echo "exit ${PIPESTATUS[0]}"
}

agent_name() {
  local agent=${GLITCH_AGENT:-}
  [[ -n $agent ]] || agent=$(omarchy-default-agent 2>/dev/null)
  case "$agent" in
  claude | codex) echo "$agent" ;;
  "") echo claude ;;
  *) log "no glitch adapter for default agent '$agent'; using claude"; echo claude ;;
  esac
}

run_agent() { "adapter_$1" "$2"; }

open_agent() {
  case "$1" in
  codex) exec omarchy-launch-tui --app-id=org.omarchy.agent codex resume --approve-for-me "$2" ;;
  *) exec omarchy-launch-tui --app-id=org.omarchy.agent claude --permission-mode auto --chrome --resume "$2" ;;
  esac
}

# --- commands -----------------------------------------------------------------------

# A key event can be delivered twice; the 300 ms window drops the repeat.
cmd_toggle() {
  local now last
  exec 8>"$RT/key.lock"
  if ! flock -n 8; then
    log "key ignored: busy"
    return
  fi
  now=${EPOCHREALTIME/./}
  last=$(cat "$RT/last-key" 2>/dev/null || echo 0)
  printf '%s' "$now" >"$RT/last-key"
  if ((now - last < 300000)); then
    log "key ignored: bounce"
    return
  fi
  if hush; then
    REACTION=$(reaction listening) set_state done "hushed"
    return
  fi
  if [[ -e $RT/recording ]]; then
    cmd_stop
  else
    cmd_start "$@"
  fi
}

cmd_start() {
  local stamp
  # voxtype's daemon is shared with Omarchy's own dictation (F9, Super+Ctrl+X).
  if [[ $(voxtype status 2>/dev/null) != idle ]]; then
    log "voxtype busy ($(voxtype status 2>/dev/null)); not recording"
    return
  fi
  [[ ${1:-} == --new ]] && touch "$RT/force-new"
  stamp=${EPOCHREALTIME/./}
  printf '%s' "$stamp" >"$RT/recording"
  stop_mutter
  voxtype record start --file="$RT/utterance.txt" --no-osd 2>>"$RT/glitch.log"
  REACTION=$(reaction listening)
  set_state listening
  chime start
  # voxtype cuts a recording at its cap, so send just before it.
  setsid bash -c 'sleep "$1"; [[ $(cat "$2" 2>/dev/null) == "$3" ]] && exec "$4" stop' _ $((RECORD_LIMIT - 10)) "$RT/recording" "$stamp" "$0" \
    </dev/null >/dev/null 2>&1 8>&- 9>&- &
}

cmd_stop() {
  local out rc text started speech
  mv "$RT/recording" "$RT/recording.$$" 2>/dev/null || return 0
  started=$(cat "$RT/recording.$$")
  rm -f "$RT/recording.$$"
  if ((${EPOCHREALTIME/./} - started < 400000)); then
    voxtype record cancel >/dev/null 2>&1
    rm -f "$RT/force-new"
    set_state idle "slip"
    return
  fi
  REACTION=$(reaction listening)
  set_state transcribing
  chime stop
  out=$(voxtype record stop --wait --json --wait-file "$RT/utterance.txt" --timeout 30 2>>"$RT/glitch.log")
  rc=$?
  text=$(tr '\n' ' ' 2>/dev/null <"$RT/utterance.txt" | sed 's/^ *//;s/ *$//')
  rm -f "$RT/utterance.txt"
  log "stop rc=$rc out=$out text=$text"
  speech=$(speech_stats $(((${EPOCHREALTIME/./} - started) / 1000)) "$text")
  local fresh=false
  [[ -e $RT/force-new ]] && fresh=true
  rm -f "$RT/force-new"
  ((rc == 0)) || text=""
  heard "$text" "$fresh" "$speech" >/dev/null
}

speech_stats() {
  jq -cn --argjson ms "$1" --argjson words "$(wc -w <<<"$2")" \
    '($ms / 1000) as $s | {seconds: ($s * 10 | round / 10), wps: (if $s > 0 then $words / $s * 10 | round / 10 else 0 end)}' 2>/dev/null
}

# Prints empty, pair, unpair, fresh or turn: libexec/portal's /api/talk outcome.
heard() {
  local text=$1 fresh=${2:-false} speech=${3:-} bare cmd=""
  # Whisper invents these from silence.
  bare=$(tr -d '[:punct:]' <<<"${text,,}" | sed 's/^ *//;s/ *$//')
  case "$bare" in
  you | "thank you" | "thanks for watching" | blankaudio | "blank audio" | bye | music) text="" ;;
  esac
  if [[ -z $text ]]; then
    chime unsure
    set_state idle "didn't catch that" "didn't catch that"
    echo empty
    return
  fi

  shopt -s nocasematch
  if [[ $PORTAL == desk && -n $PORTAL_ADDR && -f $PORTAL_CERT && $text =~ ^(un-?)?pair\ (my|the)\ phone[[:punct:]]*$ ]]; then
    cmd=pair
    [[ -n ${BASH_REMATCH[1]} ]] && cmd=unpair
  elif [[ $text =~ ^(start\ a\ )?new\ (task|chat|session|conversation)[[:punct:]]*\ *(.*)$ ]]; then
    fresh=true
    text=${BASH_REMATCH[3]}
  fi
  shopt -u nocasematch
  if [[ -n $cmd ]]; then
    REACTION=$(reaction mood.calm) set_state done "$cmd"
    "cmd_$cmd" </dev/null >/dev/null 2>&1 8>&- &
    echo "$cmd"
    return
  fi
  setsid "$0" _turn "$text" "$fresh" "$speech" </dev/null >/dev/null 2>&1 8>&- &
  if [[ -z $text ]]; then echo fresh; else echo turn; fi
}

cmd_turn() {
  local text=$1 fresh=${2:-false} agent kind rest result="" say="" mood="" denied=0
  local failed="" exit_code="" replied=false body words="" activity="" last_decide=0 fin
  local tcat id status window contour lead=0.4 note=""
  exec 9>"$RT/turn.lock"
  if [[ -z $text ]]; then
    flock 9
    forget_session
    REACTION=$(reaction mood.calm) set_state done "fresh session"
    REACTION=$(reaction mood.calm) cue --beeps 2
    return
  fi
  if ! flock -n 9; then
    set_state thinking "waiting for the last request" "waiting for the last request"
    flock 9
  fi
  trap 'rm -f "$RT/turn.portal"' EXIT
  write_atomic "$RT/turn.portal" "$PORTAL $$"
  echo $$ >"$RT/turn.pid"
  [[ $fresh == true ]] && forget_session
  [[ -n ${3:-} ]] && write_atomic "$RT/speech.json" "$3"

  agent=$(agent_name)
  SID=""
  [[ $fresh == true ]] || SID=$(current_sid "$agent") || SID=""
  log "turn agent=$agent sid=${SID:-new} text=$text"
  rm -f "$RT/live.json" "$RT/live.in"
  (($(stat -c %s "$RT/orb.events" 2>/dev/null || echo 0) > 200000)) && : >"$RT/orb.events"
  if [[ $PORTAL == phone ]]; then
    (($(stat -c %s "$PH/events.jsonl" 2>/dev/null || echo 0) > 1000000)) && : >"$PH/events.jsonl"
    find "$PH/clips" -type f -mmin +5 -delete 2>/dev/null
    rm -f "$PH"/approve.*
    # shellcheck disable=SC2016 # jq, not bash
    phone_send "$(jqs '{type:"heard", text:$s[0]}' -- "$text")"
  fi
  window=$(cat "$DATA/ctx.window" 2>/dev/null)
  [[ $window =~ ^[1-9][0-9]{0,11}$ ]] || window=""
  ev turn
  [[ -z $SID || $agent != claude ]] && ev "ctx 0"
  speech_warm
  LAST_MUTTER=$EPOCHSECONDS
  REACTION=$(reaction thinking)
  set_state thinking "$text" thinking
  live_decide "$text" "" ""

  cd "$WORKDIR" 2>/dev/null || cd "$HOME"
  while IFS= read -r line; do
    kind=${line%% *}
    rest=${line#* }
    case "$kind" in
    sid)
      if [[ -n $rest && $rest != null ]]; then
        SID=$rest
        printf '%s' "$agent" >"$RT/sid.agent"
        printf '%s' "$rest" >"$RT/sid"
      fi
      ;;
    mode) log "permission mode $rest" ;;
    tool)
      IFS=$'\t' read -r tcat id activity status <<<"$rest"
      [[ -n $note ]] && trace note "$note"
      note=""
      REACTION=$(cat "$RT/live.json" 2>/dev/null || reaction "tool.$tcat")
      set_state tool "$activity" "$status"
      ev "tool $id $tcat"
      cue --beeps 1
      live_decide "$text" "$activity" "$words"
      last_decide=$EPOCHSECONDS
      ;;
    toolend) ev "end $rest" ;;
    # Digit counts are bounded because bash arithmetic wraps past 2^63.
    ctx) [[ -n $window && $rest =~ ^[0-9]{1,12}$ ]] && ev "ctx $(printf '0.%03d' $((rest * 1000 / window > 999 ? 999 : rest * 1000 / window)))" ;;
    window)
      # Claude reports it only when a turn ends, so the tide uses the last turn's.
      [[ $rest =~ ^[1-9][0-9]{0,11}$ ]] && window=$rest && mkdir -p "$DATA" && write_atomic "$DATA/ctx.window" "$rest"
      ;;
    words)
      ev "tok ${#rest}"
      words+="$rest "
      ((${#words} > 600)) && words=${words: -600}
      if ((EPOCHSECONDS - last_decide >= LIVE_WORDS_INTERVAL)); then
        live_decide "$text" "$activity" "$words"
        last_decide=$EPOCHSECONDS
      fi
      ;;
    think) mutter "$rest" || trace think "$rest" ;;
    note)
      [[ -n $note ]] && trace note "$note"
      note=$rest
      ;;
    denied) denied=$rest ;;
    mood) mood=$rest ;;
    say) say=$rest replied=true ;;
    result) result=$(jq -r . <<<"$rest") replied=true ;;
    error) failed=$rest replied=true ;;
    exit) exit_code=$rest ;;
    esac
  done < <(printf '%s' "$text" | run_agent "$agent" "$SID")

  ev rest
  rm -f "$RT/turn.pid"
  stop_mutter
  touch "$RT/sid" 2>/dev/null
  if [[ -e $RT/cancel.$$ ]]; then
    stop_live
    [[ -n ${SPEAK_PID:-} ]] && kill "$SPEAK_PID" 2>/dev/null
    rm -f "$RT/say.fifo"
    log "turn cancelled"
    expire_later
    exit 0
  fi
  if [[ $replied == false ]]; then
    failed="the agent stopped without replying (exit ${exit_code:-?}, see glitch.log)"
  fi
  if [[ -z $say && -z $failed ]]; then
    say=$(sed -E 's/([.!?]) .*/\1/' <<<"${result:0:400}" | head -1)
    say=${say:0:160}
  fi
  mood=${mood:-calm}
  log "done denied=$denied failed=$failed mood=$mood say=$say result=${result//$'\n'/ }"
  body=$(markup_escape "${result:0:900}")
  stop_live

  [[ -n $failed ]] && say="Sorry, something went wrong."
  # shellcheck disable=SC2016 # jq, not bash
  [[ -x $PY ]] && jqs '{phase:"done", user:$s[0], say:$s[1], reply:$s[2], mood:$s[3], failed:($s[4] == "true"),
    history:($s[5] | fromjson), speech:($s[6] | fromjson), deadline:4}' -- "$text" "$say" "${result:0:900}" "$mood" \
    "$([[ -n $failed ]] && echo true || echo false)" "$(recent_history "$SID")" \
    "$(cat "$RT/speech.json" 2>/dev/null || echo null)" |
    "$PY" -I "$DECIDE" >"$RT/final.out" 2>>"$RT/glitch.log" 8>&- 9>&- &
  local decide_pid=$!
  speech_render "$say"

  local state summary
  if [[ -n $failed ]]; then
    state=error summary="glitch: something went wrong"
    REACTION=$(reaction error)
    body=$(markup_escape "$failed")
  elif [[ ${say,,} == "need you"* ]]; then
    state=needs_you summary=$say
    REACTION=$(reaction needs_you)
  else
    state=speaking summary=${say:-glitch: done}
    REACTION=$(reaction "mood.$mood")
  fi
  ((denied > 0)) && log "permission denials: $denied"

  if [[ $PORTAL == phone ]]; then
    # shellcheck disable=SC2016 # jq, not bash
    phone_send "$(jqs '{type:"reply", summary:$s[0], body:$s[1][0:4000], speech:($s[2] == "true")}' \
      -- "$say" "${failed:-$result}" "$([[ -s $RT/say.wav ]] && echo true || echo false)")"
  else
    ((CARD_SECONDS > 0)) && notify "$summary" "$body" --exec "$0" open &
  fi
  set_state "$state" "$say"
  (
    timeout 5 tail -s 0.05 --pid="$decide_pid" -f /dev/null 2>/dev/null
    fin=$(cat "$RT/final.out" 2>/dev/null)
    [[ -n $fin && $state == speaking ]] && ! recording || exit 0
    [[ $(jq -r .state "$(state_file)" 2>/dev/null) == speaking ]] || exit 0
    REACTION=$fin set_state speaking "final reaction"
  ) 8>&- 9>&- &
  local look_pid=$!
  if ! recording; then
    contour=arch
    [[ $say == *\? ]] && contour=rise
    [[ -n $failed || $mood == sorry || $mood == concerned ]] && contour=fall
    CLIP=""
    cue --contour "$contour"
    if [[ $PORTAL == desk ]]; then
      sleep "$lead"
      [[ -s $RT/say.env ]] && ev "say $(<"$RT/say.env")"
    fi
    if play "$RT/say.wav" "$CLIP" "$lead" && [[ $state == speaking && -s $RT/say.wav ]]; then
      REACTION='{"voice":"bubble","energy":0.4,"mood":"calm"}' cue --notes 360
    fi
  fi

  wait "$look_pid" 2>/dev/null
  fin=$(cat "$RT/final.out" 2>/dev/null)
  log "final ${fin:-table}"
  if [[ -n $fin && $state != needs_you ]]; then
    REACTION=$fin
  fi
  [[ $state == speaking ]] && state=done
  recording || set_state "$state" "$say"
  # shellcheck disable=SC2016 # jq, not bash
  jqs '{sid:$s[0], user:$s[1], say:$s[2], reaction:($reaction | {mood, palette, pattern, motion})}' --argjson reaction "${REACTION:-null}" \
    -- "$SID" "$text" "$say" >>"$RT/history.jsonl" 2>/dev/null
  tail -n "$((HISTORY_TURNS + 5))" "$RT/history.jsonl" >"$RT/history.tmp" 2>/dev/null && mv "$RT/history.tmp" "$RT/history.jsonl"
  wait
  expire_later
}

cmd_open() {
  local sid
  sid=$(cat "$RT/sid" 2>/dev/null)
  cd "$WORKDIR" 2>/dev/null || cd "$HOME"
  if [[ -n $sid ]]; then
    open_agent "$(cat "$RT/sid.agent" 2>/dev/null || echo claude)" "$sid"
  else
    exec omarchy-agent
  fi
}

# shellcheck disable=SC2016 # jq, not bash
APPROVE_JQ='
def qk: if test("^[A-Za-z0-9_][A-Za-z0-9_.@$/-]*$") then . else tojson end;
def one: if type == "string" and test("^[^\\s\"\\[{|#-]|^-[^\\s]") and (test("\n|\\s$") | not)
  and (test("^(true|false|null|-?[0-9.][0-9.eE+-]*)$") | not) then . else tojson end;
def doc:
  def block($h): [$h + " |"] + (split("\n") | map("  " + .));
  def item($h): if type == "string" and test("\n") then block($h)
    elif (type == "object" or type == "array") and length > 0 then [$h] + (doc | map("  " + .))
    else [$h + " " + one] end;
  if type == "object" and length > 0 then [keys[] as $k | .[$k] | item($k | qk + ":")[]]
  elif type == "array" and length > 0 then [.[] | item("-")[]]
  elif type == "string" and test("\n") then block("") | .[0] = "|"
  else [one] end;
def rest($laid): delpaths([$laid[] | [.]]) | if length == 0 then "" else doc | join("\n") end;
def head($laid): rest($laid) | if . == "" then "" else "\n" + . end;
def tail($laid): rest($laid) | if . == "" then "" else "\n\n" + . end;
def swap: "--- replace\n" + .old_string + "\n+++ with\n" + .new_string;
def laid($n):
  def s($k): .[$k] | type == "string";
  if type != "object" then null
  elif ($n | test("^(Bash|Shell)$")) and s("command") then
    {body: (.command + tail(["command", "description"])), plain: (keys - ["command", "description"] == [])}
  elif $n == "Write" and s("file_path") and s("content") then
    {body: (.file_path + head(["file_path", "content"]) + "\n\n" + .content)}
  elif $n == "Edit" and s("file_path") and s("old_string") and s("new_string") then
    {body: (.file_path + head(["file_path", "old_string", "new_string"]) + "\n" + swap)}
  elif $n == "MultiEdit" and s("file_path") and (.edits | type == "array" and length > 0
      and all(type == "object" and (.old_string | type == "string") and (.new_string | type == "string"))) then
    {body: (.file_path + head(["file_path", "edits"])
      + (.edits | map("\n" + (rest(["old_string", "new_string"]) | if . == "" then "" else . + "\n" end) + swap) | join("\n")))}
  elif $n == "NotebookEdit" and s("notebook_path") and s("new_source") then
    {body: (.notebook_path + head(["notebook_path", "new_source"]) + "\n\n" + .new_source)}
  elif $n == "WebFetch" and s("url") and s("prompt") then {body: (.url + head(["url", "prompt"]) + "\n\n" + .prompt)}
  elif $n == "WebSearch" and s("query") then {body: (.query + tail(["query"]))}
  else null end;
.tool_name as $n | ($n + ": ") as $p | .tool_input as $i
| ($i | laid($n)) as $l
| (if $l then $p + $l.body else $n + ":\n" + ($i | doc | join("\n")) end | vis) as $all | $all[0:20000] as $kept
| (try ($p + ($i.command // $i.file_path // $i.url // $i.description // ($i | tostring) | tostring
    | split("\n") | map(select(test("\\S"))) | first // "" | .[0:110]) | vis) catch null) as $short
| {tool: (if $short then $n else "" end), label: $kept, short: ($short // ""), cut: (($all | length) - ($kept | length))}
| .oneline = ($l.plain == true and .cut == 0 and .label == .short and (.label | length) <= 40
    and ($i.command | vis == . and test("\\S") and (test("[\n\t]|\\s\\s|^\\s|\\s$") | not)))
'

cmd_approve() {
  local in tool short cut shown ask pick before
  in=$(cat)
  { IFS= read -r tool; IFS= read -r short; IFS= read -r cut; IFS= read -r shown; } < <(jq -r "$JQ_DEFS$APPROVE_JQ"'
    | .tool, .short, .cut, (del(.tool) | tojson)' <<<"$in" 2>/dev/null)
  case $tool in
  Bash) ask="Okay to run that command?" ;;
  Edit | MultiEdit | Write | NotebookEdit) ask="Okay to change that file?" ;;
  WebFetch | WebSearch) ask="Okay to go online for that?" ;;
  *) ask="Okay to do that?" ;;
  esac
  log "approve? $short"
  if [[ $PORTAL == desk && (-z $tool || $tool == null || -z $short) ]]; then
    log "approve: nothing to show, denied"
    jq -cn '{hookSpecificOutput: {hookEventName: "PermissionRequest", decision: {behavior: "deny",
      message: "It couldn\u0027t be shown to the user, so it was denied. Don\u0027t retry it; say what you needed, starting the SAY line with Need you."}}}'
    return 0
  fi
  before=$(cat "$(state_file)" 2>/dev/null)
  stop_mutter
  REACTION=$(reaction needs_you)
  set_state needs_you "$short"
  cue
  APPROVE_ID=${EPOCHREALTIME/./}$$
  (speech_warm "ask.$APPROVE_ID" && speech_render "Need you: ${ask,}" && play "$SPEAK_SLOT.wav"; rm -f "$SPEAK_SLOT".*) </dev/null >/dev/null 2>&1 &
  if [[ $PORTAL == phone ]]; then
    pick=$(phone_approve "$shown" "$ask" "${cut:-1}")
  else
    pick=$(timeout 60 omarchy-menu-select "glitch wants to · $short" "󰄬	Allow once" "󰅖	Deny" -- --width 760 2>/dev/null) || pick=""
    [[ -z $pick ]] && omarchy-menu close >/dev/null 2>&1
    hush
  fi
  log "approve: ${pick:-no answer}"
  if [[ -n $before ]]; then
    REACTION=$(jq -c .reaction <<<"$before") set_state "$(jq -r .state <<<"$before")" "approved: ${pick:-none}" "$(jq -r '.status // ""' <<<"$before")"
  fi
  if [[ $pick == "Allow once" ]]; then
    jq -cn '{hookSpecificOutput: {hookEventName: "PermissionRequest", decision: {behavior: "allow"}}}'
  else
    local why="The user didn't approve it." next="Don't retry it; say what you needed, starting the SAY line with Need you."
    case $pick in
    Deny) why="The user chose Deny." ;;
    Refused) why="The user tried to allow it, but it was refused." ;;
    Unsent) why="It couldn't be shown on the user's phone, so it was denied." ;;
    esac
    [[ $PORTAL == phone && $pick != Unsent && $cut != 0 ]] &&
      next="It was too long to review on the phone, so it can't be allowed there: don't retry it as is; shorten it or split it into smaller steps."
    jq -cn --arg m "$why $next" '{hookSpecificOutput: {hookEventName: "PermissionRequest", decision: {behavior: "deny", message: $m}}}'
  fi
}

# shown goes in on stdin: a label can pass Linux's 128 KiB limit on one argument.
phone_approve() {
  local answer="" end event
  clock
  end=$((CLOCK + PORTAL_APPROVE_TIMEOUT * 100))
  if ! event=$(jq -c --arg id "$APPROVE_ID" --arg ask "$2" --argjson t "$PORTAL_APPROVE_TIMEOUT" --argjson since "$CLOCK" \
    'if type == "object" and (.label | type) == "string" then . else error("no label") end
    | {type:"approve", id:$id, ask:$ask} + . + {timeout:$t, since:($since / 100)}' <<<"$1" 2>>"$RT/glitch.log") ||
    ! phone_send "$event"; then
    log "approve: couldn't send the approval to the phone"
    echo Unsent
    return
  fi
  while [[ ! -s $PH/approve.$APPROVE_ID ]] && clock && ((CLOCK <= end)); do sleep 0.2; done
  answer=$(cat "$PH/approve.$APPROVE_ID" 2>/dev/null)
  rm -f "$PH/approve.$APPROVE_ID"
  phone_send "$(jq -cn --arg id "$APPROVE_ID" --arg a "${answer:-none}" '{type:"approved", id:$id, answer:$a}')"
  case "$answer" in
  allow) [[ $3 == 0 ]] && echo "Allow once" || echo "Refused" ;;
  deny) echo "Deny" ;;
  esac
}

cmd_cancel() {
  local pid owner
  if [[ $PORTAL == desk && -e $RT/recording ]]; then
    voxtype record cancel >/dev/null 2>&1
    rm -f "$RT/recording" "$RT/force-new"
  fi
  owner=$(turn_portal)
  hush
  pid=$(cat "$RT/turn.pid" 2>/dev/null)
  if [[ -n $pid ]] && grep -qs "_turn" "/proc/$pid/cmdline" &&
    [[ $(ps -o sid= -p "$pid" | tr -d ' ') == "$pid" ]]; then
    touch "$RT/cancel.$pid"
    pkill -INT -s "$pid" -x claude 2>/dev/null
    for _ in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    pkill -TERM -s "$pid" 2>/dev/null
    rm -f "$RT/cancel.$pid"
    exec 9>"$RT/turn.lock"
    flock -w 2 9 || return 0
    PORTAL=${owner:-$PORTAL} ev rest
  fi
  if [[ -n $owner && $owner != "$PORTAL" ]]; then
    PORTAL=$owner hush
    REACTION=$(reaction mood.unsure) PORTAL=$owner set_state idle cancelled cancelled
  fi
  REACTION=$(reaction mood.unsure) set_state idle cancelled cancelled
}

# glitch-remote keeps every session it spawned (~650 MB with its MCP servers, and
# one of 32 slots) until it restarts, since Claude parks only claude.ai project
# threads. A restarted server respawns a session with its context on the next
# message, but drops a turn left waiting with no process (an unanswered
# question, a /loop).
cmd_reap() {
  local main dir recent p top up grace procs
  [[ $REMOTE_IDLE_MIN =~ ^[1-9][0-9]*$ ]] || { echo "REMOTE_IDLE_MIN must be a positive number" >&2; return 1; }
  main=$(systemctl --user show -p MainPID --value glitch-remote.service)
  ((${main:-0} > 0)) || return 0
  # A restart leaves one pre-created session, so with one there's nothing to free.
  (($(pgrep -c -P "$main") > 1)) || return 0
  dir=$(tr '\0' '\n' <"/proc/$main/environ" | sed -n 's/^CLAUDE_CONFIG_DIR=//p')
  dir="${dir:-$HOME/.claude}/projects"
  [[ -d $dir ]] || return 0
  recent=$(find "$dir" -name '*.jsonl' -mmin -"$REMOTE_IDLE_MIN" -print -quit) || return 1
  [[ -z $recent ]] || return 0
  # The restart kills the whole cgroup, so wait while it holds anything besides
  # the server, its sessions, and whatever hangs off a child a session started
  # within seconds of itself (MCP servers). Anything else is a tool call or a job
  # an agent left running. A wl-copy still serving an agent's copy doesn't count.
  stat_field() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | cut -d' ' -f"$2"; } # 2 ppid, 20 start time
  grace=$((10 * $(getconf CLK_TCK)))
  procs=$(<"/sys/fs/cgroup$(cut -d: -f3- "/proc/$main/cgroup")/cgroup.procs") || return 1
  for p in $procs; do
    [[ $p == "$main" || $(cat "/proc/$p/comm" 2>/dev/null) == wl-copy ]] && continue
    top=$p up=$(stat_field "$p" 2)
    [[ $up == "$main" ]] && continue
    while [[ -n $up && $(stat_field "$up" 2) != "$main" ]]; do
      top=$up up=$(stat_field "$up" 2)
    done
    ((${up:-0} > 1)) || return 0
    (($(stat_field "$top" 20) - $(stat_field "$up" 20) <= grace)) || return 0
  done
  log "remote: every session idle ${REMOTE_IDLE_MIN}m, restarting glitch-remote"
  systemctl --user restart glitch-remote.service
}

say_aside() {
  speech_warm aside
  speech_render "$*"
  play "$RT/aside.wav"
}

cmd_pair() {
  local PORTAL=desk code
  [[ $SPEAK == 1 && -x $PY && -f $VOICE ]] || { echo "glitch pair: needs speech (SPEAK=1 and a Piper voice) to say the code" >&2; return 1; }
  code=$(printf '%06d' $(($(od -An -N4 -tu4 /dev/urandom) % 1000000)))
  mkdir -p "$PH"
  write_atomic "$PH/pair" "$(jq -cn --arg h "$(printf '%s' "$code" | sha256sum | cut -d' ' -f1)" \
    --argjson e $((EPOCHSECONDS + 120)) '{hash:$h, expires:$e, tries:0}')"
  log "pairing open for 2 minutes"
  say_aside "Your phone code is ${code:0:1} ${code:1:1} ${code:2:1}, ${code:3:1} ${code:4:1} ${code:5:1}."
}

cmd_unpair() {
  local PORTAL=desk
  mkdir -p "$DATA/portal" && chmod 700 "$DATA/portal"
  (flock 9 && rm -f "$DATA/portal/devices" "$PH/pair") 9>"$DATA/portal/devices.lock"
  log "phones unpaired"
  say_aside "Done, your phone is unpaired."
}

# Chrome on Android ignores name constraints on user-installed roots, so the CA signs
# once and its key is destroyed. Chrome caps lifetimes only under publicly trusted roots,
# so neither certificate expires (RFC 5280's 99991231235959Z). notBefore is a day back
# for a phone clock that runs slow. Android installs a "CA certificate" only with CA:TRUE.
cmd_cert() {
  local ca="$DATA/portal/glitch-ca.crt" from to=99991231235959Z fp d
  if [[ ! $PORTAL_ADDR =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo "glitch cert: set PORTAL_ADDR (this machine's LAN address, e.g. 192.168.1.20) in $USER_CONF/glitch.conf" >&2
    return 1
  fi
  if [[ $1 != --renew && (-e $PORTAL_CERT || -e $ca) ]]; then
    echo "glitch cert: the phone already trusts $ca; a new one stops that until it's installed again." >&2
    echo "  Make a new one with: glitch cert --renew" >&2
    return 1
  fi
  # On tmpfs, so the CA key never reaches the disk: shred can't erase a file on btrfs.
  # Not local, because the EXIT trap runs after this function returns.
  tmp=$(mktemp -d -p "$RT") || return 1
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 130' INT TERM
  from=$(date -u -d '-1 day' +%Y%m%d%H%M%SZ)
  if ! (
    set -e
    cd "$tmp"
    printf '%s\n' '[req]' 'distinguished_name = dn' '[dn]' \
      '[ca]' 'basicConstraints = critical, CA:TRUE, pathlen:0' 'keyUsage = critical, keyCertSign' 'subjectKeyIdentifier = hash' \
      '[leaf]' 'basicConstraints = critical, CA:FALSE' 'keyUsage = critical, digitalSignature' 'extendedKeyUsage = serverAuth' \
      "subjectAltName = IP:$PORTAL_ADDR" 'subjectKeyIdentifier = hash' 'authorityKeyIdentifier = keyid' >x509.cnf
    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out ca.key
    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out key.pem
    openssl req -x509 -new -config x509.cnf -extensions ca -key ca.key -subj "/CN=glitch portal $PORTAL_ADDR (key destroyed)" \
      -sha256 -not_before "$from" -not_after "$to" -out ca.pem
    openssl req -new -config x509.cnf -key key.pem -subj "/CN=$PORTAL_ADDR" -out leaf.csr
    openssl x509 -req -in leaf.csr -CA ca.pem -CAkey ca.key -extfile x509.cnf -extensions leaf \
      -sha256 -not_before "$from" -not_after "$to" -out cert.pem 2>/dev/null
    shred -u ca.key
    openssl verify -x509_strict -purpose sslserver -CAfile ca.pem cert.pem >/dev/null
    openssl x509 -in ca.pem -outform DER -out ca.crt
  ); then
    rm -rf "$tmp"
    echo "glitch cert: openssl failed" >&2
    return 1
  fi
  for d in "$DATA/portal" "$(dirname "$PORTAL_CERT")" "$(dirname "$PORTAL_KEY")"; do mkdir -p "$d" && chmod 700 "$d"; done
  install -m 600 "$tmp/key.pem" "$PORTAL_KEY.new" && mv "$PORTAL_KEY.new" "$PORTAL_KEY" &&
    install -m 644 "$tmp/cert.pem" "$PORTAL_CERT.new" && mv "$PORTAL_CERT.new" "$PORTAL_CERT" &&
    install -m 644 "$tmp/ca.crt" "$ca.new" && mv "$ca.new" "$ca"
  d=$?
  rm -rf "$tmp"
  ((d == 0)) || { echo "glitch cert: couldn't write the certificate" >&2; return 1; }
  fp=$(portal_ca_fingerprint)
  log "portal certificate made for $PORTAL_ADDR (CA $fp)"
  echo "CA file for the phone: $ca"
  echo "SHA-256: $fp"
  echo "On the phone: Settings > Security & privacy > More security settings > Encryption & credentials > Install a certificate > CA certificate,"
  echo "pick this file, then check this fingerprint against the one under Trusted credentials > User."
  echo "It vouches only for $PORTAL_ADDR, and its key is gone."
  [[ $1 == --renew ]] && echo "The portal serves the new certificate once restarted: systemctl --user restart glitch-portal"
  return 0
}

portal_ca_fingerprint() { openssl x509 -inform DER -in "$DATA/portal/glitch-ca.crt" -noout -fingerprint -sha256 | cut -d= -f2; }

# Prints the root commands still needed for the phone to reach PORTAL_ADDR:PORTAL_PORT.
portal_reach() {
  local lan a b c d n rules prefs routes ts todo=()
  lan=$(ip -j -4 addr show 2>/dev/null | jq -r --arg a "$PORTAL_ADDR" \
    '.[] | select(.ifname != "tailscale0") | .addr_info[] | select(.local == $a) | .prefixlen' | head -1)
  if [[ -z $lan ]]; then
    echo "warning: $PORTAL_ADDR (PORTAL_ADDR) isn't an address of this machine (ip -4 addr)"
  elif command -v ufw >/dev/null; then
    IFS=. read -r a b c d <<<"$PORTAL_ADDR"
    n=$(((a << 24 | b << 16 | c << 8 | d) & (0xffffffff << (32 - lan)) & 0xffffffff))
    lan="$((n >> 24)).$((n >> 16 & 255)).$((n >> 8 & 255)).$((n & 255))/$lan"
    # ufw saves each rule in user.rules as "### tuple ### allow tcp <port> <dst> any <src> in[_<iface>]".
    rules=$(cat /etc/ufw/user.rules 2>/dev/null)
    grep -q "^### tuple ### allow tcp $PORTAL_PORT 0\.0\.0\.0/0 any ${lan//./\\.} in\b" <<<"$rules" ||
      todo+=("sudo ufw allow from $lan to any port $PORTAL_PORT proto tcp comment 'glitch portal LAN'")
    grep -q "^### tuple ### allow tcp $PORTAL_PORT 0\.0\.0\.0/0 any 0\.0\.0\.0/0 in_tailscale0\b" <<<"$rules" ||
      todo+=("sudo ufw allow in on tailscale0 to any port $PORTAL_PORT proto tcp comment 'glitch portal Tailscale'")
  fi
  if command -v tailscale >/dev/null; then
    # --advertise-routes replaces the whole list, so repeat the routes already advertised.
    prefs=$(tailscale debug prefs 2>/dev/null) || prefs='{"AdvertiseRoutes":["<routes it already advertises>"]}'
    routes=$(jq -r --arg r "$PORTAL_ADDR/32" '.AdvertiseRoutes // [] | if index([$r]) then "" else . + [$r] | join(",") end' <<<"$prefs")
    ts="sudo "
    [[ $(jq -r '.OperatorUser // ""' <<<"$prefs") == "$(id -un)" ]] && ts=
    [[ -n $routes ]] && todo+=("${ts}tailscale set --advertise-routes=$routes")
  fi
  ((${#todo[@]})) || return 0
  echo "To reach it from the phone, run:"
  printf '  %s\n' "${todo[@]}"
  [[ ${todo[*]} == *advertise-routes* ]] &&
    echo "then approve the $PORTAL_ADDR/32 route in the Tailscale admin console (Machines) and turn on Use Tailscale subnets in the phone's Tailscale app (only needed away from home)"
  return 0
}

portal_status() {
  if [[ -z $PORTAL_ADDR || ! -f $DATA/portal/glitch-ca.crt ]] || ! systemctl --user is-enabled --quiet glitch-portal.service 2>/dev/null; then
    echo "off (turn it on with: glitch phone)"
  elif systemctl --user is-active --quiet glitch-portal.service; then
    echo "https://$PORTAL_ADDR:$PORTAL_PORT (pair a phone: glitch pair)"
    portal_reach
  else
    echo "warning: glitch-portal isn't running (journalctl --user -u glitch-portal)"
  fi
}

cmd_phone() {
  local url route dev unit conf="$USER_CONF/glitch.conf"
  case ${1:-} in
  --status) portal_status; return 0 ;;
  --off)
    systemctl --user disable --now glitch-portal.service >/dev/null 2>&1
    echo "The phone portal is off. Paired phones stay paired; glitch phone turns it back on."
    return 0
    ;;
  esac
  if [[ -z $PORTAL_ADDR ]]; then
    route=$(ip -j -4 route get 1.1.1.1 2>/dev/null)
    PORTAL_ADDR=$(jq -r '.[0].prefsrc // empty' <<<"$route")
    dev=$(jq -r '.[0].dev // empty' <<<"$route")
    # A VPN's or a public address would put the portal, and its certificate, on the wrong network.
    # /sys type 1 is Ethernet or Wi-Fi; tunnels are not.
    if [[ ! $PORTAL_ADDR =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9.]+$ || $dev == tap* ||
      $(cat "/sys/class/net/$dev/type" 2>/dev/null) != 1 ]]; then
      echo "glitch phone: couldn't tell this machine's home network address (found ${PORTAL_ADDR:-none} on ${dev:-no interface})." >&2
      echo "  Set PORTAL_ADDR to its LAN address (ip -4 addr) in $conf and run glitch phone again." >&2
      return 1
    fi
    mkdir -p "$USER_CONF"
    [[ -s $conf && -n $(tail -c1 "$conf") ]] && echo >>"$conf"
    printf 'PORTAL_ADDR=%s\n' "$PORTAL_ADDR" >>"$conf"
    echo "1. Address: $PORTAL_ADDR on $dev (written to $conf)."
    echo "   The certificate and the paired app are tied to it, so reserve it for this machine in your router (a DHCP reservation)."
  else
    echo "1. Address: $PORTAL_ADDR"
  fi
  if [[ -f $DATA/portal/glitch-ca.crt && -f $PORTAL_CERT && -f $PORTAL_KEY ]]; then
    echo "2. Certificate: have one"
  else
    cmd_cert "" >/dev/null || return 1
    echo "2. Certificate: made"
  fi
  # systemctl disable (glitch phone --off) removes a linked unit's file too.
  unit="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/glitch-portal.service"
  mkdir -p "${unit%/*}" && ln -sfn "$GLITCH_HOME/systemd/glitch-portal.service" "$unit"
  systemctl --user daemon-reload
  systemctl --user enable glitch-portal.service >/dev/null 2>&1
  systemctl --user restart glitch-portal.service >/dev/null 2>&1
  sleep 2
  if ! systemctl --user is-active --quiet glitch-portal.service; then
    echo "glitch phone: glitch-portal didn't start (journalctl --user -u glitch-portal)" >&2
    return 1
  fi
  echo "3. Portal: running"
  portal_reach | sed 's/^/   /'
  url="https://$PORTAL_ADDR:$PORTAL_PORT/setup"
  echo "4. On the phone (Android, Chrome), on the same Wi-Fi, open $url"
  command -v qrencode >/dev/null && qrencode -t ANSIUTF8 -m 2 "$url"
  echo "   Chrome warns that the connection isn't private, because the phone doesn't trust the certificate yet:"
  echo "   choose Advanced, then Proceed. The page hands over the certificate and walks through installing it."
  echo "5. Before pairing, check what the phone installed: Settings > Security & privacy > More security settings > Encryption & credentials >"
  echo "   Trusted credentials > User, tap the glitch certificate, and compare its SHA-256 fingerprint with this one:"
  echo "   $(portal_ca_fingerprint)"
  echo "   If they differ, remove it: something on the network answered in this computer's place."
  echo "6. Then say \"pair my phone\" at the desk (or run: glitch pair) and type the code on the phone."
}

# 78 is EX_CONFIG, which glitch-portal.service doesn't restart on.
cmd_portal() {
  local PORTAL=desk addr=$PORTAL_ADDR args c py=python3
  if [[ ${GLITCH_PORTAL_PLAIN:-} == 1 ]]; then
    addr=127.0.0.1 args=(--plain)
  elif [[ -z $addr ]]; then
    echo "glitch portal: set PORTAL_ADDR (this machine's LAN address) in $USER_CONF/glitch.conf" >&2
    exit 78
  elif [[ ! -f $PORTAL_CERT || ! -f $PORTAL_KEY ]]; then
    echo "glitch portal: no certificate at $PORTAL_CERT and key at $PORTAL_KEY" >&2
    exit 78
  else
    args=(--cert "$PORTAL_CERT" --key "$PORTAL_KEY")
  fi
  mkdir -p "$PH/sounds" "$PH/clips"
  for c in "${CHIMES[@]}"; do chime "$c" --out "$PH/sounds/$c.wav"; done
  wait
  [[ -x $PY ]] && py=$PY
  exec "$py" -I "$GLITCH_HOME/libexec/portal" "${args[@]}" --addr "$addr" --port "$PORTAL_PORT" --rt "$RT" --data "$DATA" \
    --glitch "$GLITCH_HOME/bin/glitch" --web "$GLITCH_HOME/web" --plugin "$GLITCH_HOME/plugin" --max-seconds "$RECORD_LIMIT"
}

card_sweep
case "${1:-}" in
toggle) shift; cmd_toggle "$@" ;;
stop) exec 8>"$RT/key.lock"; flock 8; cmd_stop ;;
_turn) cmd_turn "$2" "${3:-false}" "${4:-}" ;;
_heard) heard "$2" false "$(speech_stats "${3:-0}" "$2")" ;;
_reactions) reactions . ;;
pair) cmd_pair ;;
unpair) cmd_unpair ;;
portal) cmd_portal ;;
cert) cmd_cert "${2:-}" ;;
phone) cmd_phone "${2:-}" ;;
_live) cmd_live ;;
_mutter) cmd_mutter ;;
_expire) cmd_expire "${2:-}" ;;
_approve) cmd_approve ;;
_reap) cmd_reap ;;
open) cmd_open ;;
new) setsid "$0" _turn "" true </dev/null >/dev/null 2>&1 & ;;
cancel) cmd_cancel ;;
hush) hush ;;
say)
  shift
  say_aside "$@"
  ;;
state) cat "$RT/state.json" 2>/dev/null ;;
*) sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
