#!/bin/bash

# glitch: tap a key, speak, tap again, and your coding agent does it, while an
# expressive orb (a port of Yohei Nakajima's Beep Jev) shows how it's going,
# beeps its mood, and speaks a short answer.
#
#   glitch toggle [--new]  start recording, or stop and send (Super+D / Super+Alt+D)
#   glitch open            open the current session in a terminal (Super+Alt+Shift+D)
#   glitch cancel          stop recording, the running turn and speech (Super+Alt+Backspace)
#   glitch new             forget the current session
#   glitch hush            stop speaking
#   glitch say <text>      speak text with glitch's voice
#   glitch state           print the current orb state
#
# Layout (see README.md):
#   code       this repo, symlinked into place by install.sh
#   defaults   <repo>/config/{glitch.conf,voice-prompt.md,reactions.json}
#   overrides  ~/.config/glitch/ (glitch.conf is sourced after the default,
#              reactions.json is merged over it, voice-prompt.md replaces it)
#   data       ~/.local/share/glitch/ (venv, voices, models, llama.cpp, mind.key)
#   runtime    $XDG_RUNTIME_DIR/glitch/ (state.json, sid, history.jsonl, glitch.log)

set -uo pipefail
export LC_CTYPE=${LC_CTYPE:-C.UTF-8} # string slicing below must count characters

GLITCH_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/glitch"
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/glitch"
RT="${XDG_RUNTIME_DIR:-/run/user/$UID}/glitch"
mkdir -p "$RT"

# shellcheck source=../config/glitch.conf
. "$GLITCH_HOME/config/glitch.conf"
# shellcheck source=/dev/null
[[ -f $USER_CONF/glitch.conf ]] && . "$USER_CONF/glitch.conf"
export GLITCH_BEEP_VOLUME="${BEEP_VOLUME:-1.0}"

PY="$DATA/venv/bin/python"
CUE="$GLITCH_HOME/libexec/cue"
DECIDE="$GLITCH_HOME/libexec/decide"
SPEAK_HELPER="$GLITCH_HOME/libexec/speak"

# Locks: key.lock (fd 8) serializes key presses, turn.lock (fd 9) serializes
# turns. Every detached child closes both (`8>&- 9>&-`), or it would keep the
# lock and every later press would log "key ignored: busy".

# Keep the log short; it lives in tmpfs.
if [[ -f $RT/glitch.log ]] && (($(wc -l <"$RT/glitch.log") > 2000)); then
  tail -n 1000 "$RT/glitch.log" >"$RT/glitch.log.tmp" && mv "$RT/glitch.log.tmp" "$RT/glitch.log"
fi

log() { printf '%(%T)T.%s %s\n' -1 "${EPOCHREALTIME:11:3}" "$*" >>"$RT/glitch.log"; }

# Write $2 to $1 so concurrent readers never see a half-written file.
write_atomic() { printf '%s\n' "$2" >"$1.$$" && mv "$1.$$" "$1"; }

# Publish the orb state: state.json for readers, IPC so the orb updates now.
# `detail` only goes to the log.
set_state() {
  local json
  json=$(jq -cn --arg s "$1" --argjson reaction "${REACTION:-null}" '{state:$s, reaction:$reaction}')
  write_atomic "$RT/state.json" "$json"
  log "state $1 ${2:-}"
  omarchy-shell -q glitch set "$json" >/dev/null 2>&1 || true
}

current_sid() {
  local f="$RT/sid"
  [[ -s $f ]] || return 1
  ((EPOCHSECONDS - $(stat -c %Y "$f") < RESUME_WINDOW)) || return 1
  cat "$f"
}

forget_session() {
  rm -f "$RT/sid" "$RT/history.jsonl"
  close_card
}

# Beep Jev style reaction for a state or mood: the repo's reactions.json with
# the user's copy (if any) merged over it.
#   reaction listening | reaction tool.look | reaction mood.happy
reaction() {
  local files=("$GLITCH_HOME/config/reactions.json")
  [[ -f $USER_CONF/reactions.json ]] && files+=("$USER_CONF/reactions.json")
  jq -cs --arg k "$1" '(reduce .[] as $f ({}; . * $f)) | getpath($k | split(".")) // .mood.calm' "${files[@]}" 2>/dev/null || echo null
}

voice_prompt() {
  if [[ -f $USER_CONF/voice-prompt.md ]]; then cat "$USER_CONF/voice-prompt.md"; else cat "$GLITCH_HOME/config/voice-prompt.md"; fi
}

# Beep phrase for the current reaction (see libexec/cue). Fire and forget;
# --beeps N plays a short tick instead of a full phrase.
cue() {
  [[ $BEEPS == 1 && -x $PY && ${REACTION:-null} != null ]] || return 0
  setsid "$PY" -I "$CUE" "$@" "$REACTION" </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
}

# --- speech -------------------------------------------------------------------
# A turn warms Piper up front (libexec/speak loads the voice while the agent
# works), then says one line through a FIFO when the reply arrives.

speech_warm() {
  rm -f "$RT/say.wav" "$RT/say.fifo"
  [[ $SPEAK == 1 && -x $PY && -f $VOICE ]] || return 0
  mkfifo "$RT/say.fifo" || return 0
  "$PY" -I "$SPEAK_HELPER" "$VOICE" "$RT/say.fifo" "$RT/say.wav" </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
  SPEAK_PID=$!
}

# Hand the warm voice its line and wait for the audio file.
speech_render() {
  [[ -n ${SPEAK_PID:-} ]] || return 0
  timeout 5 bash -c 'printf "%s" "$1" >"$2"' _ "$1" "$RT/say.fifo" 2>/dev/null
  timeout 5 tail --pid="$SPEAK_PID" -f /dev/null 2>/dev/null
  kill "$SPEAK_PID" 2>/dev/null
  rm -f "$RT/say.fifo"
  SPEAK_PID=""
}

# Play a rendered file; `glitch hush` (or any key press) stops it.
play() {
  [[ -s $1 ]] || return 0
  pw-play "$1" 2>/dev/null 8>&- 9>&- &
  echo $! >"$RT/speak.pid"
  wait $! 2>/dev/null
  rm -f "$RT/speak.pid"
}

hush() {
  local pid
  pid=$(cat "$RT/speak.pid" 2>/dev/null) || return 1
  kill "$pid" 2>/dev/null
  rm -f "$RT/speak.pid"
}

# --- the reply card -------------------------------------------------------------
# One sticky card stands for the live session. Critical is the only urgency the
# Omarchy shell keeps on screen; re-sending with the card's id updates it in
# place. It closes when the resume window runs out or a new session starts.

# Escape for the card body, which the shell renders as StyledText.
markup_escape() {
  local s=${1//&/&amp;}
  s=${s//</&lt;}
  printf '%s' "${s//>/&gt;}"
}

notify() {
  local id
  id=$(omarchy-notification-send --app-name glitch -g "󰍬" -u critical -p \
    -r "$(cat "$RT/notify.id" 2>/dev/null || echo 0)" "$@" 2>>"$RT/glitch.log") || {
    log "notify failed: $1"
    return 0
  }
  [[ $id =~ ^[0-9]+$ ]] && printf '%s' "$id" >"$RT/notify.id"
  printf '%s' "$1" >"$RT/notify.summary"
}

close_card() {
  local summary
  summary=$(cat "$RT/notify.summary" 2>/dev/null) || return 0
  # The shell ignores D-Bus CloseNotification for on-screen cards; its own IPC
  # dismisses every card whose summary *contains* the text, from any app, so
  # summaries are always the (long, specific) SAY line or "glitch: …".
  [[ -n $summary ]] && omarchy-shell -q notifications dismiss "$summary" >/dev/null 2>&1
  rm -f "$RT/notify.id" "$RT/notify.summary"
}

expire_later() {
  local mt
  mt=$(stat -c %Y "$RT/sid" 2>/dev/null) || return 0
  setsid bash -c "sleep $((RESUME_WINDOW + 2)); [[ \$(stat -c %Y '$RT/sid' 2>/dev/null) == $mt ]] && exec '$0' _expire" \
    </dev/null >/dev/null 2>&1 8>&- 9>&- &
}

# --- live reactions (the local decision model, see libexec/decide) --------------

# This session's last HISTORY_TURNS turns, for continuity between reactions.
recent_history() {
  if ((HISTORY_TURNS > 0)) && [[ -s $RT/history.jsonl ]]; then
    jq -cs --arg sid "${1:-}" --argjson n "$HISTORY_TURNS" '[.[] | select(.sid == $sid)] | .[-$n:]' "$RT/history.jsonl"
  else
    echo '[]'
  fi
}

# Queue a decision about what's happening right now; the newest request wins
# and a single worker keeps at most one in flight.
live_decide() {
  [[ -x $PY ]] || return 0
  write_atomic "$RT/live.in" "$(jq -cn --arg user "$1" --arg activity "$2" --arg words "$3" \
    --argjson history "$(recent_history "$SID")" \
    --argjson speech "$(cat "$RT/speech.json" 2>/dev/null || echo null)" \
    '{phase:"working", user:$user, activity:$activity, words:$words, history:$history, speech:$speech, deadline:3}')"
  setsid "$0" _live </dev/null >/dev/null 2>>"$RT/glitch.log" 8>&- 9>&- &
}

cmd_live() {
  local r state
  exec 7>"$RT/live.lock"
  flock -n 7 || return 0
  while mv "$RT/live.in" "$RT/live.cur" 2>/dev/null; do
    "$PY" -I "$DECIDE" <"$RT/live.cur" >"$RT/live.out" &
    echo $! >"$RT/live.pid"
    wait $!
    rm -f "$RT/live.pid"
    r=$(cat "$RT/live.out" 2>/dev/null)
    [[ -n $r && -e $RT/turn.pid ]] || continue
    state=$(cat "$RT/state.json" 2>/dev/null)
    [[ $(jq -r .state <<<"$state" 2>/dev/null) =~ ^(thinking|tool)$ ]] || continue
    write_atomic "$RT/live.json" "$r"
    log "live $r"
    omarchy-shell -q glitch set "$(jq -c --argjson r "$r" '.reaction = $r' <<<"$state")" >/dev/null 2>&1
  done
  exec 7>&-
  # A request that landed after the last check would otherwise be stranded.
  [[ -e $RT/live.in ]] && exec "$0" _live
}

stop_live() {
  local pid
  rm -f "$RT/live.in"
  pid=$(cat "$RT/live.pid" 2>/dev/null) || return 0
  grep -qs libexec/decide "/proc/$pid/cmdline" && kill "$pid" 2>/dev/null
}

# --- agent adapters ---------------------------------------------------------------
# An adapter reads the prompt on stdin, takes an optional session id, and emits
# lines: "sid <id>", "mode <permission mode>", "tool <category>\t<label>",
# "words <text>", "say <text>", "mood <word>", "result <json string>",
# "error <text>", "denied <n>", then "exit <status>" last. Tool categories:
# look, make, run, delegate.

adapter_claude() {
  local sid=${1:-} args
  args=(-p --output-format stream-json --verbose --include-partial-messages
    --permission-mode auto --permission-prompts none
    --append-system-prompt "$(voice_prompt)")
  [[ -n $sid ]] && args+=(--resume "$sid")
  # SIGINT ends a turn cleanly (SIGTERM leaves it unrecorded).
  timeout --signal=INT --kill-after=15 "$TURN_TIMEOUT" claude "${args[@]}" 2>>"$RT/glitch.log" 9>&- |
    jq --unbuffered -rR 'fromjson? // empty |
    def clip(n): if length > n then .[0:n] + "…" else . end;
    def tlabel: .name + (
      (.input.file_path // .input.path // .input.command // .input.pattern // .input.url // .input.description // "")
      | tostring | split("\n")[0] | sub("^/home/[^/]+/"; "~/") | if . == "" then "" else ": " + clip(48) end);
    def tcat: .name as $n |
      if ($n | test("^(Read|Glob|Grep|LS|WebFetch|WebSearch|ToolSearch)$")) then "look"
      elif ($n | test("^(Edit|MultiEdit|Write|NotebookEdit)$")) then "make"
      elif ($n | test("^(Task|Agent)$")) then "delegate"
      else "run" end;
    def tagline(k): [.[] | select(test("^\\s*" + k + ":"))] | last // "" | sub("^\\s*" + k + ":\\s*"; "");
    if .type == "stream_event" then
      (.event.delta // {} | (.text // .thinking // empty) | "words \(gsub("\\s+"; " "))")
    elif .type == "system" and .subtype == "init" then "sid \(.session_id)", "mode \(.permissionMode // "?")"
    elif .type == "assistant" then (.message.content[]? | select(.type == "tool_use") | "tool \(tcat)\t\(tlabel)")
    elif .type == "result" then
      "sid \(.session_id)",
      (if (.permission_denials // [] | length) > 0 then "denied \(.permission_denials | length)" else empty end),
      (if .is_error then "error \((.result | select(. != "")) // .subtype // "error" | tostring | gsub("\n"; " "))"
       else (.result // "" | split("\n")) as $ls |
         "mood \($ls | tagline("MOOD") | ascii_downcase | gsub("[^a-z]"; ""))",
         "say \($ls | tagline("SAY") | gsub("\n"; " "))",
         "result \([$ls[] | select(test("^\\s*(SAY|MOOD):") | not)] | join("\n") | sub("\\s+$"; "") | tojson)"
       end)
    else empty end'
  echo "exit ${PIPESTATUS[0]}"
}

# glitch follows Omarchy's default agent where it has an adapter for it, and
# uses Claude Code otherwise.
agent_name() {
  local agent
  agent=$(omarchy-default-agent 2>/dev/null)
  case "$agent" in
  claude | "") echo claude ;;
  *) log "no glitch adapter for default agent '$agent'; using claude"; echo claude ;;
  esac
}

run_agent() { "adapter_$1" "$2"; }

open_agent() { exec omarchy-launch-tui --app-id=org.omarchy.agent claude --resume "$2"; }

# --- commands -----------------------------------------------------------------------

# Tap to start, tap again to send. Every key press funnels through here under
# key.lock, so a press that lands while the last one is still transcribing is
# dropped instead of desyncing the orb from voxtype. The 300 ms window absorbs
# a key event delivered twice.
cmd_toggle() {
  local now last
  exec 8>"$RT/key.lock"
  if ! flock -n 8; then
    log "key ignored: busy"
    return
  fi
  now=${EPOCHREALTIME/./}
  last=$(cat "$RT/last-key" 2>/dev/null || echo 0)
  printf '%s' "$now" >"$RT/last-key"
  if ((now - last < 300000)); then
    log "key ignored: bounce"
    return
  fi
  # A press while glitch is talking just quiets it.
  if hush; then
    REACTION=$(reaction listening) set_state done "hushed"
    return
  fi
  if [[ -e $RT/recording ]]; then
    cmd_stop
  else
    cmd_start "$@"
  fi
}

cmd_start() {
  local stamp
  # voxtype's daemon is shared with Omarchy's own dictation (F9, Super+Ctrl+X).
  if [[ $(voxtype status 2>/dev/null) != idle ]]; then
    log "voxtype busy ($(voxtype status 2>/dev/null)); not recording"
    return
  fi
  [[ ${1:-} == --new ]] && touch "$RT/force-new"
  stamp=${EPOCHREALTIME/./}
  printf '%s' "$stamp" >"$RT/recording"
  voxtype record start --file="$RT/utterance.txt" --no-osd 2>>"$RT/glitch.log"
  REACTION=$(reaction listening)
  set_state listening
  cue --beeps 1
  # Watchdog: a forgotten recording sends itself just before voxtype's own cap.
  setsid bash -c "sleep $((RECORD_LIMIT - 10)); [[ \$(cat '$RT/recording' 2>/dev/null) == $stamp ]] && exec '$0' stop" \
    </dev/null >/dev/null 2>&1 8>&- 9>&- &
}

cmd_stop() {
  local out rc text started bare
  mv "$RT/recording" "$RT/recording.$$" 2>/dev/null || return 0
  started=$(cat "$RT/recording.$$")
  rm -f "$RT/recording.$$"
  # Start and stop within 0.4 s is a slip, not a request.
  if ((${EPOCHREALTIME/./} - started < 400000)); then
    voxtype record cancel >/dev/null 2>&1
    rm -f "$RT/force-new"
    set_state idle "slip"
    return
  fi
  REACTION=$(reaction listening)
  set_state transcribing
  cue --beeps 2
  out=$(voxtype record stop --wait --json --wait-file "$RT/utterance.txt" --timeout 30 2>>"$RT/glitch.log")
  rc=$?
  text=$(tr '\n' ' ' 2>/dev/null <"$RT/utterance.txt" | sed 's/^ *//;s/ *$//')
  rm -f "$RT/utterance.txt"
  log "stop rc=$rc out=$out text=$text"
  # How long and how fast you talked: the voice version of Beep Jev's typing speed.
  jq -cn --argjson ms "$(((${EPOCHREALTIME/./} - started) / 1000))" --argjson words "$(wc -w <<<"$text")" \
    '($ms / 1000) as $s | {seconds: ($s * 10 | round / 10), wps: (if $s > 0 then $words / $s * 10 | round / 10 else 0 end)}' \
    >"$RT/speech.json" 2>/dev/null
  # Whisper invents these from silence.
  bare=$(tr -d '[:punct:]' <<<"${text,,}" | sed 's/^ *//;s/ *$//')
  case "$bare" in
  you | "thank you" | "thanks for watching" | blankaudio | "blank audio" | bye | music) text="" ;;
  esac
  if ((rc != 0)) || [[ -z $text ]]; then
    rm -f "$RT/force-new"
    REACTION=$(reaction mood.unsure) cue --beeps 1
    set_state idle "didn't catch that"
    return
  fi

  # "new task, ..." / "new chat" starts fresh; the rest of the sentence is the prompt.
  shopt -s nocasematch
  if [[ $text =~ ^(start\ a\ )?new\ (task|chat|session|conversation)[[:punct:]]*\ *(.*)$ ]]; then
    touch "$RT/force-new"
    text=${BASH_REMATCH[3]}
  fi
  shopt -u nocasematch
  local fresh=false
  if [[ -e $RT/force-new ]]; then
    rm -f "$RT/force-new"
    forget_session
    fresh=true
  fi
  if [[ -z $text ]]; then
    REACTION=$(reaction mood.calm) set_state done "fresh session"
    REACTION=$(reaction mood.calm) cue --beeps 2
    return
  fi

  # Run the turn detached so the keybinding (and key.lock) returns immediately.
  setsid "$0" _turn "$text" "$fresh" </dev/null >/dev/null 2>&1 8>&- &
}

cmd_turn() {
  local text=$1 fresh=${2:-false} agent kind rest result="" say="" mood="" denied=0
  local failed="" exit_code="" replied=false body words="" activity="" last_decide=0 fin
  exec 9>"$RT/turn.lock"
  if ! flock -n 9; then
    set_state thinking "waiting for the last request"
    flock 9
  fi
  echo $$ >"$RT/turn.pid"

  agent=$(agent_name)
  SID=""
  [[ $fresh == true ]] || SID=$(current_sid) || SID=""
  log "turn agent=$agent sid=${SID:-new} text=$text"
  rm -f "$RT/live.json" "$RT/live.in"
  speech_warm
  REACTION=$(reaction thinking)
  set_state thinking "$text"
  live_decide "$text" "" ""

  cd "$WORKDIR" 2>/dev/null || cd "$HOME"
  while IFS= read -r line; do
    kind=${line%% *}
    rest=${line#* }
    case "$kind" in
    sid) [[ -n $rest && $rest != null ]] && SID=$rest && printf '%s' "$rest" >"$RT/sid" ;;
    mode) log "permission mode $rest" ;;
    tool)
      activity=${rest#*$'\t'}
      # Instant feedback from the table (or the last live decision), then let
      # the model refine it.
      REACTION=$(cat "$RT/live.json" 2>/dev/null || reaction "tool.${rest%%$'\t'*}")
      set_state tool "$activity"
      cue --beeps 1
      live_decide "$text" "$activity" "$words"
      last_decide=$EPOCHSECONDS
      ;;
    words)
      words+="$rest "
      ((${#words} > 600)) && words=${words: -600}
      if ((EPOCHSECONDS - last_decide >= LIVE_WORDS_INTERVAL)); then
        live_decide "$text" "$activity" "$words"
        last_decide=$EPOCHSECONDS
      fi
      ;;
    denied) denied=$rest ;;
    mood) mood=$rest ;;
    say) say=$rest replied=true ;;
    result) result=$(jq -r . <<<"$rest") replied=true ;;
    error) failed=$rest replied=true ;;
    exit) exit_code=$rest ;;
    esac
  done < <(printf '%s' "$text" | run_agent "$agent" "$SID")

  rm -f "$RT/turn.pid"
  touch "$RT/sid" 2>/dev/null # the resume window counts from the end of the turn
  if [[ -e $RT/cancel.$$ ]]; then
    stop_live
    [[ -n ${SPEAK_PID:-} ]] && kill "$SPEAK_PID" 2>/dev/null
    rm -f "$RT/say.fifo"
    log "turn cancelled"
    exit 0
  fi
  if [[ $replied == false ]]; then
    failed="the agent stopped without replying (exit ${exit_code:-?}, see glitch.log)"
  fi
  # No SAY line (the agent ignored the convention): fall back to the first sentence.
  if [[ -z $say && -z $failed ]]; then
    say=$(sed -E 's/([.!?]) .*/\1/' <<<"${result:0:400}" | head -1)
    say=${say:0:160}
  fi
  mood=${mood:-calm}
  log "done denied=$denied failed=$failed mood=$mood say=$say result=${result//$'\n'/ }"
  body=$(markup_escape "${result:0:900}")
  stop_live

  # Speak first with Claude's own mood; the model's final reaction lands on the
  # orb when it's ready.
  [[ -n $failed ]] && say="Sorry, something went wrong."
  [[ -x $PY ]] && jq -cn --arg user "$text" --arg say "$say" --arg reply "${result:0:900}" --arg mood "$mood" \
    --argjson failed "$([[ -n $failed ]] && echo true || echo false)" --argjson history "$(recent_history "$SID")" \
    --argjson speech "$(cat "$RT/speech.json" 2>/dev/null || echo null)" \
    '{phase:"done", user:$user, say:$say, reply:$reply, mood:$mood, failed:$failed, history:$history, speech:$speech, deadline:4}' |
    "$PY" -I "$DECIDE" >"$RT/final.out" 2>>"$RT/glitch.log" 8>&- 9>&- &
  local decide_pid=$!
  speech_render "$say"

  local state summary
  if [[ -n $failed ]]; then
    state=error summary="glitch: something went wrong"
    REACTION=$(reaction error)
    body=$(markup_escape "$failed")
  elif [[ ${say,,} == "need you"* ]]; then
    state=needs_you summary=$say
    REACTION=$(reaction needs_you)
  else
    state=speaking summary=${say:-glitch: done}
    REACTION=$(reaction "mood.$mood")
  fi
  ((denied > 0)) && log "permission denials: $denied"

  notify "$summary" "$body" --exec "$0" open &
  set_state "$state" "$say"
  # Don't talk over a recording that started meanwhile.
  if [[ ! -e $RT/recording ]]; then
    cue
    sleep 0.4 # let the beeps lead into the voice
    play "$RT/say.wav"
  fi

  timeout 5 tail --pid="$decide_pid" -f /dev/null 2>/dev/null
  fin=$(cat "$RT/final.out" 2>/dev/null)
  log "final ${fin:-table}"
  if [[ -n $fin && $state != needs_you ]]; then
    REACTION=$fin
  fi
  [[ $state == speaking ]] && state=done
  [[ -e $RT/recording ]] || set_state "$state" "$say"
  jq -cn --arg sid "$SID" --arg user "$text" --arg say "$say" --argjson reaction "${REACTION:-null}" \
    '{sid:$sid, user:$user, say:$say, reaction:($reaction | {mood, palette, pattern, motion})}' >>"$RT/history.jsonl" 2>/dev/null
  tail -n "$((HISTORY_TURNS + 5))" "$RT/history.jsonl" >"$RT/history.tmp" 2>/dev/null && mv "$RT/history.tmp" "$RT/history.jsonl"
  wait
  expire_later
}

cmd_open() {
  local sid
  sid=$(cat "$RT/sid" 2>/dev/null)
  cd "$WORKDIR" 2>/dev/null || cd "$HOME"
  if [[ -n $sid ]]; then
    open_agent "$(agent_name)" "$sid"
  else
    exec omarchy-agent
  fi
}

cmd_cancel() {
  local pid
  if [[ -e $RT/recording ]]; then
    voxtype record cancel >/dev/null 2>&1
    rm -f "$RT/recording" "$RT/force-new"
  fi
  hush
  pid=$(cat "$RT/turn.pid" 2>/dev/null)
  # Turns run in their own session (cmd_stop setsid's them), so the session id
  # is the turn's pid; anything else isn't ours to kill.
  if [[ -n $pid ]] && grep -qs "_turn" "/proc/$pid/cmdline" &&
    [[ $(ps -o sid= -p "$pid" | tr -d ' ') == "$pid" ]]; then
    touch "$RT/cancel.$pid" # the turn ends quietly instead of reporting an error
    pkill -INT -s "$pid" -x claude 2>/dev/null
    for _ in 1 2 3 4 5 6; do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    pkill -TERM -s "$pid" 2>/dev/null
    rm -f "$RT/cancel.$pid"
  fi
  REACTION=$(reaction mood.unsure) set_state idle "cancelled"
}

case "${1:-}" in
toggle) shift; cmd_toggle "$@" ;;
stop) exec 8>"$RT/key.lock"; flock 8; cmd_stop ;; # the recording watchdog
_turn) cmd_turn "$2" "${3:-false}" ;;
_live) cmd_live ;;
_expire) close_card ;;
open) cmd_open ;;
new) forget_session; REACTION=$(reaction mood.calm) set_state done "fresh session" ;;
cancel) cmd_cancel ;;
hush) hush ;;
say)
  shift
  speech_warm
  speech_render "$*"
  play "$RT/say.wav"
  ;;
state) cat "$RT/state.json" 2>/dev/null ;;
*) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
