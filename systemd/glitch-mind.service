[Unit]
Description=glitch mind: local decision model (llama.cpp + Qwen3 1.7B) for the orb's reactions

[Service]
# Two slots so the final reaction never queues behind a live one; prompts are
# ~400 tokens, so 1024 per slot is plenty. The key (made by install.sh) keeps
# web pages from driving the model through localhost.
ExecStart=%h/.local/share/glitch/llama/llama-server -m %h/.local/share/glitch/models/Qwen3-1.7B-Q4_K_M.gguf -ngl 99 --host 127.0.0.1 --port 8765 -c 2048 -np 2 --no-slots --no-webui --api-key-file %h/.local/share/glitch/mind.key
Restart=on-failure
Nice=5

[Install]
WantedBy=default.target
