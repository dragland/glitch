[Unit]
Description=glitch mind: local decision model (llama.cpp + Qwen3 1.7B) for the orb's reactions

[Service]
ExecStart=%h/.local/share/glitch/llama/llama-server -m %h/.local/share/glitch/models/Qwen3-1.7B-Q4_K_M.gguf -ngl 99 --host 127.0.0.1 --port 8765 -c 4096 -np 2 --no-webui
Restart=on-failure
Nice=5

[Install]
WantedBy=default.target
