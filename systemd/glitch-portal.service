[Unit]
Description=glitch portal: the phone page (HTTPS on the LAN) for the same voice companion
# In the graphical session, so its turns get WAYLAND_DISPLAY and the session's PATH (mise's claude).
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# %D is XDG_DATA_HOME. glitch cert writes this file.
ConditionPathExists=%D/glitch/portal/glitch-ca.crt

[Service]
ExecStart=%h/.local/bin/glitch portal
# Turns run detached in this cgroup, so a restart must not kill them.
KillMode=process
Restart=on-failure
RestartSec=5
# glitch portal exits 78 when PORTAL_ADDR or the certificate is missing.
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
