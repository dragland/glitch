[Unit]
Description=glitch remote: Claude Code remote control (start sessions from the Claude app)
# In the graphical session, so sessions get WAYLAND_DISPLAY and the session's PATH (mise's claude)
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
# Runs in WORKDIR with REMOTE_PERMISSION_MODE (glitch.conf).
ExecStart=%h/.local/bin/glitch _remote
# The status screen redraws every second; keep only stderr
StandardOutput=null
StandardError=journal
# Exits 0 after ~10 min offline. A killed run holds the folder lease for a few
# minutes ("already served"), so keep retrying.
Restart=always
RestartSec=30
# glitch _remote exits 78 when REMOTE isn't 1 or WORKDIR is missing.
RestartPreventExitStatus=78

[Install]
WantedBy=graphical-session.target
